        outcome: "Nhân vật khám phá rằng việc học hỏi không chỉ thuộc về tuổi trẻ."
      },
      {
        title: "Dành thời gian cho gia đình",
        desc: "Chia sẻ những khoảnh khắc bình thường.",
        effects: { family: 6, relationships: 3 },
        next: "elder",
        outcome: "Những khoảnh khắc giản dị trở thành một phần quan trọng của ký ức."
      },
      {
        title: "Sắp xếp điều còn dang dở",
        desc: "Giải quyết những việc vẫn khiến mình bận tâm.",
        effects: { meaning: 5, mood: 3 },
        next: "elder",
        outcome: "Không phải mọi việc đều có thể hoàn tất, nhưng nhân vật có thể chọn điều cần ưu tiên."
      }
    ]
  }
};


/* TRẠNG THÁI GAME */

let G = null;

const DAILY = [
  {
    title:"Học hoặc rèn kỹ năng",
    desc:"Đầu tư thời gian cho kiến thức.",
    icon:"▤",
    effects:{learning:5,skills:2,energy:-5}
  },
  {
    title:"Nghỉ ngơi",
    desc:"Hồi phục sức lực.",
    icon:"☾",
    effects:{energy:9,mood:3}
  },
  {
    title:"Gặp gỡ bạn bè",
    desc:"Nuôi dưỡng mối quan hệ.",
    icon:"♙",
    effects:{relationships:4,mood:3,energy:-2}
  },
  {
    title:"Dành thời gian cho gia đình",
    desc:"Trò chuyện và chia sẻ.",
    icon:"⌂",
    effects:{family:4,mood:2}
  },
  {
    title:"Theo đuổi sở thích",
    desc:"Làm điều khiến bản thân hứng thú.",
    icon:"✧",
    effects:{skills:3,mood:5,energy:-2}
  }
];

function clamp(n){return Math.max(0,Math.min(100,n));}
function esc(s){
  return String(s??"").replace(/[&<>"']/g,c=>({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  })[c]);
}
function screen(id){
  document.querySelectorAll(".screen").forEach(s=>s.classList.remove("active"));
  document.getElementById(id).classList.add("active");
}
function modal(id,open){
  document.getElementById(id).classList.toggle("open",open);
}
function showModal(id){
  renderModals();
  modal(id,true);
}
function hideModal(id){modal(id,false);}

function startGame(){
  G={
    name:document.getElementById("newName").value.trim()||"An",
    gender:document.getElementById("newGender").value,
    temperament:document.getElementById("newTemper").value,
    family:document.getElementById("newFamily").value,
    difficulty:document.getElementById("difficulty").value,
    day:0,age:0,stage:"Trước khi sinh",
    stats:{
      energy:65,mood:60,learning:5,skills:8,
      relationships:10,family:35,meaning:5,money:25
    },
    flags:{},people:{},history:[],journal:[],
    scene:"birth",pending:null,finished:false
  };

  G.people["Gia đình"]={score:35,memory:[]};

  record("Ngày 0","Cuộc đời bắt đầu trong hoàn cảnh gia đình: "+familyName()+".");
  screen("game");
  showScene("birth");
  render();
  saveGame(false);
}

function familyName(){
  return ({
    stable:"gia đình ổn định",
    poor:"gia đình có nguồn lực hạn chế",
    expect:"gia đình có kỳ vọng cao",
    warm:"gia đình giàu tình cảm",
    busy:"gia đình bận rộn"
  })[G.family]||G.family;
}

function currentStage(){
  if(G.age<3)return "Ấu nhi";
  if(G.age<6)return "Mầm non";
  if(G.age<11)return "Tiểu học";
  if(G.age<15)return "THCS";
  if(G.age<18)return "THPT";
  if(G.age<25)return "Trưởng thành trẻ";
  if(G.age<40)return "Xây dựng cuộc sống";
  if(G.age<60)return "Trung niên";
  if(G.age<75)return "Tuổi già";
  return "Cuối đời";
}

/* Mở một cảnh */
function showScene(key){
  if(!G||!STORY[key])return;

  G.scene=key;
  G.pending=null;

  const s=STORY[key];
  G.stage=currentStage();

  document.getElementById("chapterLabel").textContent=s.chapter;
  document.getElementById("sceneArt").textContent=s.art;
  document.getElementById("sceneTitle").textContent=s.title;
  document.getElementById("sceneText").textContent=s.text;
  document.getElementById("eventBox").textContent=s.body;
  document.getElementById("choiceHeading").textContent="Bạn sẽ lựa chọn thế nào?";
  document.getElementById("choiceCounter").textContent=s.choices.length+" lựa chọn";

  document.getElementById("choiceList").innerHTML=s.choices.map((c,i)=>`
    <button class="choice" onclick="choose(${i})">
      <span class="choice-number">0${i+1}</span>
      <strong>${esc(c.title)}</strong>
      <small>${esc(c.desc)}</small>
    </button>
  `).join("");

  document.getElementById("resultBox").classList.add("hidden");
  document.getElementById("continueBtn").classList.add("hidden");

  G.history.push({
    type:"scene",scene:key,title:s.title,day:G.day,age:G.age
  });
  render();
}

/* Xử lý lựa chọn */
function choose(index){
  if(!G||G.pending)return;

  const s=STORY[G.scene];
  const c=s.choices[index];
  if(!c)return;

  applyEffects(c.effects||{});

  if(c.person){
    const p=G.people[c.person]||(G.people[c.person]={score:0,memory:[]});
    p.score=clamp(p.score+(c.relation||0)+50)-50;
    p.memory.push(c.title);
  }

  G.pending={
    next:c.next,
    outcome:c.outcome,
    choice:c.title
  };

  record("Lựa chọn: "+c.title,c.outcome);

  document.getElementById("choiceList").innerHTML="";
  document.getElementById("choiceHeading").textContent="Hệ quả trước mắt";
  document.getElementById("choiceCounter").textContent="Đã lựa chọn";

  const box=document.getElementById("resultBox");
  box.classList.remove("hidden");
  box.innerHTML=`
    <strong class="gold">${esc(c.title)}</strong>
    <p>${esc(c.outcome)}</p>
    <p class="muted">Lựa chọn đã được ghi lại. Hệ quả có thể tiếp tục xuất hiện trong các tình huống sau.</p>
  `;

  document.getElementById("continueBtn").classList.remove("hidden");
  render();
  saveGame(false);
}

function continueStory(){
  if(!G||!G.pending)return;

  const next=G.pending.next;
  G.pending=null;

  /*
    Chỉ số tuổi dùng để điều chỉnh giai đoạn hiện tại.
    Đây là nguyên mẫu, chưa mô phỏng từng ngày trong 80 năm.
  */

  if(G.age<3)G.age=3;
  else if(G.age<6)G.age=6;
  else if(G.age<11)G.age=11;
  else if(G.age<15)G.age=15;
  else if(G.age<18)G.age=18;
  else if(G.age<25)G.age=25;
  else if(G.age<40)G.age=40;
  else if(G.age<60)G.age=60;
  else if(G.age<75)G.age=75;
  else if(next==="elder"){
    G.age=79;
    finishLife();
    return;
  }

  G.day+=30;
  G.stage=currentStage();

  if(next==="elder"&&G.age<60)G.age=60;
  if(next==="midlife"&&G.age<35)G.age=35;
  if(next==="career"&&G.age<18)G.age=18;
  if(next==="futureChoice"&&G.age<15)G.age=15;

  /*
    Nếu người chơi đã đi qua một cảnh nhiều lần,
    cảnh tiếp theo vẫn mở ra các lựa chọn mới của cảnh đó.
    Các ký ức, chỉ số và nhật ký vẫn được giữ lại.
  */

  showScene(next);
  saveGame(false);
}

/* Cập nhật chỉ số */
function applyEffects(effects){
  for(const [key,value] of Object.entries(effects)){
    if(!(key in G.stats))continue;
    let v=value;

    if(G.difficulty==="easy")v=Math.round(v*0.75);
    if(G.difficulty==="hard")v=Math.round(v*1.2);

    G.stats[key]=clamp(G.stats[key]+v);
  }
}

/* Hoạt động thường ngày */
function renderDaily(){
  const el=document.getElementById("dailyActions");

  el.innerHTML=DAILY.map((a,i)=>`
    <button class="choice" onclick="dailyAction(${i})">
      <strong>${a.icon} ${esc(a.title)}</strong>
      <small>${esc(a.desc)}</small>
    </button>
  `).join("");
}

function dailyAction(i){
  if(!G)return;
  const a=DAILY[i];
  applyEffects(a.effects);
  G.day++;
  record("Hoạt động thường ngày: "+a.title,a.desc);
  render();
  saveGame(false);
}

/* Nhật ký */
function record(title,text){
  if(!G)return;
  const entry={
    title,text,day:G.day,age:G.age,
    stage:currentStage()
  };
  G.journal.unshift(entry);
  if(G.journal.length>500)G.journal.pop();
}

/* Giao diện trạng thái */
function render(){
  if(!G)return;

  document.getElementById("playerName").textContent=G.name;
  document.getElementById("playerTags").innerHTML=`
    <span class="tag">${esc(G.gender)}</span>
    <span class="tag">${esc(G.temperament)}</span>
    <span class="tag">${esc(familyName())}</span>
  `;

  document.getElementById("dateLabel").textContent="NGÀY "+G.day;
  document.getElementById("ageLabel").textContent="Tuổi "+G.age;
  document.getElementById("stageLabel").textContent=currentStage();
  document.getElementById("lifeProgress").style.width=Math.min(100,G.age/80*100)+"%";

  const statInfo={
    energy:["Năng lượng","mint"],
    mood:["Tâm trạng","pinkbar"],
    learning:["Kiến thức","bluebar"],
    skills:["Kỹ năng","goldbar"],
    relationships:["Bạn bè","mint"],
    family:["Gia đình","pinkbar"],
    meaning:["Ý nghĩa","goldbar"],
    money:["Nguồn lực","bluebar"]
  };

  document.getElementById("stats").innerHTML=
    Object.entries(statInfo).map(([key,info])=>`
      <div class="stat">
        <div class="stat-top">
          <span>${info[0]}</span>
          <strong>${G.stats[key]}</strong>
        </div>
        <div class="bar ${info[1]}"><i style="width:${G.stats[key]}%"></i></div>
      </div>
    `).join("");

  document.getElementById("recentHistory").innerHTML=
    G.journal.slice(0,5).map(j=>`
      <div class="history-item">
        <time>Ngày ${j.day} · Tuổi ${j.age}</time>
        <strong>${esc(j.title)}</strong><br>
        ${esc(j.text)}
      </div>
    `).join("")||"<p class='muted'>Chưa có sự kiện.</p>";

  document.getElementById("peopleMini").innerHTML=
    Object.entries(G.people).map(([name,p])=>`
      <div class="relationship">
        <strong>${esc(name)}</strong><br>
        <small>${p.memory.length} ký ức được ghi lại</small>
      </div>
    `).join("");

  renderDaily();
  renderModals();
}

/* Nội dung modal */
function renderModals(){
  if(!G)return;

  document.getElementById("journalList").innerHTML=
    G.journal.map(j=>`
      <div class="history-item">
        <time>Ngày ${j.day} · Tuổi ${j.age} · ${esc(j.stage)}</time>
        <strong>${esc(j.title)}</strong><br>
        ${esc(j.text)}
      </div>
    `).join("")||"<p>Nhật ký đang trống.</p>";

  document.getElementById("peopleList").innerHTML=
    Object.entries(G.people).map(([name,p])=>`
      <div class="relationship">
        <h3>${esc(name)}</h3>
        <p class="muted">Số ký ức đã lưu: ${p.memory.length}</p>
        <strong>Những điều được ghi nhớ</strong>
        <ul>${p.memory.map(m=>`<li>${esc(m)}</li>`).join("")||"<li>Chưa có ký ức cụ thể.</li>"}</ul>
      </div>
    `).join("");
}

/* Lưu game */
function saveGame(showAlert){
  if(!G){
    if(showAlert)alert("Bạn chưa bắt đầu cuộc đời.");
    return;
  }
  try{
    localStorage.setItem(SAVE_KEY,JSON.stringify(G));
    if(showAlert)alert("Đã lưu tiến trình trên trình duyệt.");
  }catch(e){
    if(showAlert)alert("Không thể lưu. Hãy thử trình duyệt khác.");
  }
}

function loadGame(){
  try{
    const raw=localStorage.getItem(SAVE_KEY);
    if(!raw){alert("Chưa có bản lưu.");return;}
    G=JSON.parse(raw);
    screen(G.finished?"ending":"game");
    if(G.finished)renderEnding();
    else{
      render();
      if(G.pending){
        const s=STORY[G.scene];
        document.getElementById("choiceList").innerHTML="";
        document.getElementById("resultBox").classList.remove("hidden");
        document.getElementById("resultBox").textContent=G.pending.outcome;
        document.getElementById("continueBtn").classList.remove("hidden");
      }else{
        showScene(G.scene);
      }
    }
  }catch(e){
    alert("Không đọc được bản lưu.");
  }
}

/* Kết thúc hành trình */
function finishLife(){
  G.finished=true;
  record("Cuối hành trình","Cuộc đời của "+G.name+" khép lại.");
  saveGame(false);
  screen("ending");
  renderEnding();
}

function renderEnding(){
  document.getElementById("endingName").textContent=G.name;

  const milestones=G.journal.slice(-12).reverse().map(j=>
    "• Tuổi "+j.age+" — "+j.title+": "+j.text
  ).join("\n\n");

  document.getElementById("memoir").textContent=
    G.name+" đã đi qua một hành trình với nhiều lựa chọn.\n\n"+
    "Điểm xuất phát: "+familyName()+".\n"+
    "Khuynh hướng tính cách: "+G.temperament+".\n\n"+
    "NHỮNG DẤU MỐC ĐƯỢC GHI LẠI\n\n"+
    milestones+"\n\n"+
    "Không có một con số nào kể hết được cuộc đời này. "+
    "Những điều nhân vật đã lựa chọn, những người từng gặp và "+
    "những gì đã thay đổi cùng thời gian tạo nên câu chuyện riêng.";
}

function newLife(){
  if(!confirm("Bắt đầu một cuộc đời mới?"))return;
  G=null;
  screen("setup");
}
</script>
</body>
</html>
