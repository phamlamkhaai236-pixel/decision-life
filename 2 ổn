<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Decision Simulator — Pixel Life</title>

<style>
:root{
  --bg:#101323;
  --panel:#1b2038;
  --panel2:#252b49;
  --line:#444c73;
  --text:#f3f1ff;
  --muted:#a9b0d0;
  --gold:#ffcf70;
  --mint:#83e3bd;
  --pink:#ff9fb8;
  --blue:#8dc7ff;
  --purple:#c6a5ff;
}
*{box-sizing:border-box}
body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:monospace;
  line-height:1.65;
  image-rendering:pixelated;
}
button,input,select{font:inherit}
button{
  color:var(--text);
  background:#303858;
  border:2px solid #505a83;
  padding:12px;
  cursor:pointer;
  box-shadow:0 4px 0 #111426;
}
button:hover{background:#414a70}
button:active{transform:translateY(2px);box-shadow:0 2px 0 #111426}
button:disabled{opacity:.45;cursor:not-allowed}
input,select{
  width:100%;
  padding:12px;
  margin:5px 0 15px;
  color:var(--text);
  background:#11162a;
  border:2px solid var(--line);
}
h1,h2,h3,p{margin-top:0}
h1{font-size:clamp(27px,5vw,44px);line-height:1.25}
h2{font-size:21px}
small,.muted{color:var(--muted)}
header{
  padding:17px;
  border-bottom:3px solid #303858;
  background:#171b30;
}
.header-inner,main{
  max-width:1200px;
  margin:auto;
}
.header-inner{
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:12px;
}
.logo{font-weight:bold;font-size:19px}
.logo span{color:var(--gold)}
.header-buttons{display:flex;gap:8px;flex-wrap:wrap}
main{padding:22px 15px 50px}
.screen{display:none}
.screen.active{display:block}
.panel{
  background:var(--panel);
  border:2px solid var(--line);
  padding:17px;
  margin-bottom:15px;
  box-shadow:5px 5px 0 #090c18;
}
.hero{
  padding:clamp(22px,5vw,45px);
  background:
    linear-gradient(135deg,#292448,#19243c 65%,#203e4b);
}
.kicker{
  color:var(--mint);
  letter-spacing:2px;
  font-size:12px;
}
.pixel-scene{
  min-height:155px;
  border:3px solid #58648d;
  margin:20px 0;
  padding:20px;
  background:
    linear-gradient(180deg,#303b66 0%,#72557e 52%,#d38c84 53%,#39465c 54%,#25364a 100%);
  display:flex;
  align-items:flex-end;
  gap:15px;
}
.pixel-person{
  font-size:45px;
  filter:drop-shadow(4px 4px 0 #182039);
}
.pixel-caption{
  padding:10px;
  background:#12172bd9;
  border:2px solid #7d86a8;
}
.grid{
  display:grid;
  grid-template-columns:repeat(12,minmax(0,1fr));
  gap:15px;
}
.span-12{grid-column:span 12}
.span-7{grid-column:span 7}
.span-5{grid-column:span 5}
.layout{
  display:grid;
  grid-template-columns:minmax(0,1.7fr) minmax(260px,.8fr);
  gap:15px;
}
.row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:10px;
}
.tag{
  display:inline-block;
  padding:3px 8px;
  border:1px solid #657097;
  background:#171d32;
  color:var(--muted);
  font-size:11px;
  margin:2px;
}
.gold{color:var(--gold)}
.mint{color:var(--mint)}
.pixel-line{height:4px;background:#3c4569;margin:12px 0}
.event-box{
  padding:17px;
  background:#141a2d;
  border-left:5px solid var(--gold);
  margin:17px 0;
}
.scene-art{
  font-size:34px;
  padding:15px 0;
}
.choices{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:11px;
}
.choice{
  text-align:left;
  min-height:115px;
  background:#202844;
  border-color:#465477;
}
.choice strong{
  display:block;
  color:var(--gold);
  margin-bottom:7px;
}
.choice small{display:block;line-height:1.5}
.choice .choice-number{
  float:right;
  color:#8995bd;
  font-size:12px;
}
.choice:hover{border-color:var(--mint)}
.choice:disabled{opacity:.5}
.primary{
  color:#171526;
  background:var(--gold);
  border-color:#ffe5a3;
  font-weight:bold;
}
.secondary{background:#263b47;border-color:#477c80}
.danger{background:#45283b;border-color:#8a4b66}
.stats{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:9px;
}
.stat{
  background:#11172a;
  padding:10px;
  border:1px solid #394464;
}
.stat-top{
  display:flex;
  justify-content:space-between;
  font-size:11px;
  gap:4px;
}
.bar{
  height:8px;
  margin-top:7px;
  background:#333c5a;
}
.bar i{display:block;height:100%;background:var(--mint)}
.bar.goldbar i{background:var(--gold)}
.bar.pinkbar i{background:var(--pink)}
.bar.bluebar i{background:var(--blue)}
.history{
  display:grid;
  gap:8px;
  max-height:330px;
  overflow:auto;
}
.history-item{
  background:#13192b;
  border:1px solid #343e5d;
  padding:10px;
  font-size:12px;
}
.history-item time{
  display:block;
  color:var(--mint);
  margin-bottom:5px;
  font-size:10px;
}
.logbox{
  padding:13px;
  background:#171d32;
  border:1px dashed #596589;
  margin-top:15px;
}
.hidden{display:none!important}
.modal{
  display:none;
  position:fixed;
  inset:0;
  z-index:20;
  background:#080a15eF;
  padding:20px;
  align-items:center;
  justify-content:center;
}
.modal.open{display:flex}
.modal-inner{
  width:min(750px,100%);
  max-height:85vh;
  overflow:auto;
  background:var(--panel);
  border:3px solid var(--line);
  padding:20px;
}
.relationship{
  padding:12px;
  background:#141a2d;
  border:1px solid var(--line);
  margin:8px 0;
}
footer{
  text-align:center;
  color:#747e9f;
  padding:25px;
  font-size:11px;
}
@media(max-width:760px){
  .layout{grid-template-columns:1fr}
  .span-7,.span-5{grid-column:span 12}
  .choices{grid-template-columns:1fr}
  .choice{min-height:85px}
  .pixel-scene{align-items:center}
}
</style>
</head>

<body>
<header>
  <div class="header-inner">
    <div class="logo">▣ DECISION <span>SIMULATOR</span></div>
    <div class="header-buttons">
      <button onclick="showModal('journalModal')">▤ Nhật ký</button>
      <button onclick="showModal('peopleModal')">♙ Nhân vật</button>
      <button onclick="saveGame(true)">↓ Lưu game</button>
    </div>
  </div>
</header>

<main>

<!-- TẠO NHÂN VẬT -->
<section id="setup" class="screen active">
  <div class="panel hero">
    <div class="kicker">PIXEL LIFE SIMULATION · VERSION 0.6</div>
    <h1>Một cuộc đời.<br><span class="gold">Hàng nghìn ngã rẽ.</span></h1>
    <p class="muted">
      Mỗi lựa chọn mở ra một khả năng. Mỗi khả năng có thể tạo ra
      một tình huống mới. Không có cuộc đời nào được viết sẵn từ đầu.
    </p>

    <div class="pixel-scene">
      <div class="pixel-person">♟</div>
      <div class="pixel-caption">
        <strong>NGÀY 0 — TRƯỚC KHI BẮT ĐẦU</strong><br>
        <small>Một thế giới đang chờ nhân vật của bạn.</small>
      </div>
    </div>
  </div>

  <div class="grid">
    <div class="panel span-7">
      <div class="kicker">01 / CHARACTER</div>
      <h2>Tạo nhân vật</h2>

      <label for="newName">Tên nhân vật</label>
      <input id="newName" maxlength="24" value="An">

      <label for="newGender">Giới tính nhân vật</label>
      <select id="newGender">
        <option>Nữ</option>
        <option>Nam</option>
        <option>Phi nhị nguyên</option>
        <option>Tùy chỉnh</option>
      </select>

      <label for="newTemper">Khuynh hướng tính cách</label>
      <select id="newTemper">
        <option>Tò mò</option>
        <option>Thận trọng</option>
        <option>Cởi mở</option>
        <option>Kiên trì</option>
        <option>Nhạy cảm</option>
        <option>Ưa độc lập</option>
      </select>
    </div>

    <div class="panel span-5">
      <div class="kicker">02 / BACKGROUND</div>
      <h2>Hoàn cảnh ban đầu</h2>

      <label for="newFamily">Gia đình</label>
      <select id="newFamily">
        <option value="stable">Ổn định</option>
        <option value="poor">Kinh tế chật vật</option>
        <option value="expect">Kỳ vọng cao</option>
        <option value="warm">Giàu tình cảm</option>
        <option value="busy">Cha mẹ bận rộn</option>
      </select>

      <label for="difficulty">Độ khó của cuộc đời</label>
      <select id="difficulty">
        <option value="story">Cân bằng — nhiều diễn biến</option>
        <option value="easy">Nhẹ nhàng — dễ phục hồi</option>
        <option value="hard">Thử thách — hệ quả kéo dài</option>
      </select>
    </div>

    <div class="panel span-12">
      <button class="primary" onclick="startGame()">BẮT ĐẦU CUỘC ĐỜI ▶</button>
      <button onclick="loadGame()">Tiếp tục bản lưu</button>
    </div>
  </div>
</section>

<!-- GAME -->
<section id="game" class="screen">
  <div class="layout">
    <div>
      <div class="panel">
        <div class="row">
          <span id="dateLabel" class="gold">NGÀY 0</span>
          <span id="ageLabel" class="tag">Trước khi sinh</span>
        </div>

        <div class="pixel-line"></div>
        <div id="sceneArt" class="scene-art">☼</div>
        <div class="kicker" id="chapterLabel">CHƯƠNG 0</div>
        <h2 id="sceneTitle">Một khởi đầu</h2>
        <p id="sceneText" class="muted"></p>

        <div id="eventBox" class="event-box"></div>

        <div class="row">
          <h3 id="choiceHeading">Bạn sẽ làm gì?</h3>
          <span id="choiceCounter" class="tag">5 lựa chọn</span>
        </div>

        <div id="choiceList" class="choices"></div>

        <div id="resultBox" class="logbox hidden"></div>

        <div class="row" style="margin-top:15px">
          <button id="continueBtn" class="primary hidden" onclick="continueStory()">
            Tiếp tục câu chuyện →
          </button>
          <button onclick="showModal('journalModal')">Đọc nhật ký</button>
        </div>
      </div>

      <div class="panel">
        <div class="kicker">DAILY LIFE</div>
        <h2>Đời sống thường ngày</h2>
        <p class="muted">
          Ngoài các cốt truyện lớn, bạn có thể lựa chọn cách sử dụng thời gian.
          Hành động thường ngày có thể ảnh hưởng đến trạng thái nhân vật.
        </p>
        <div id="dailyActions" class="choices"></div>
      </div>
    </div>

    <aside>
      <div class="panel">
        <div class="kicker">PLAYER STATUS</div>
        <h2 id="playerName">An</h2>
        <div id="playerTags"></div>
        <div id="stats" class="stats"></div>
      </div>

      <div class="panel">
        <div class="row">
          <h3>Người quen</h3>
          <button onclick="showModal('peopleModal')">Xem</button>
        </div>
        <div id="peopleMini"></div>
      </div>

      <div class="panel">
        <div class="kicker">LIFE JOURNAL</div>
        <h3>Những dấu mốc gần đây</h3>
        <div id="recentHistory" class="history"></div>
      </div>

      <div class="panel">
        <div class="kicker">LIFE PROGRESS</div>
        <h3 id="stageLabel">Trước khi sinh</h3>
        <div class="bar goldbar"><i id="lifeProgress" style="width:0%"></i></div>
        <p class="muted" style="font-size:11px">
          Quá khứ được lưu lại. Tương lai còn phụ thuộc vào những điều bạn chọn.
        </p>
      </div>
    </aside>
  </div>
</section>

<!-- KẾT THÚC -->
<section id="ending" class="screen">
  <div class="panel hero">
    <div class="kicker">THE END OF A LIFE</div>
    <h1>Hành trình của <span id="endingName" class="gold"></span></h1>
    <p class="muted">Một cuộc đời không thể chỉ được đo bằng thành công hay thất bại.</p>
    <div id="memoir" class="event-box"></div>
    <button class="primary" onclick="newLife()">Bắt đầu cuộc đời khác ↻</button>
    <button onclick="showModal('journalModal')">Đọc lại nhật ký</button>
  </div>
</section>

</main>

<footer>DECISION SIMULATOR · PIXEL LIFE · LOCAL PROTOTYPE</footer>

<!-- NHẬT KÝ -->
<div id="journalModal" class="modal">
  <div class="modal-inner">
    <div class="row">
      <h2>▤ Nhật ký cuộc đời</h2>
      <button onclick="hideModal('journalModal')">Đóng ✕</button>
    </div>
    <p class="muted">Các quyết định, sự kiện và hệ quả đã được ghi lại.</p>
    <div id="journalList" class="history"></div>
  </div>
</div>

<!-- NHÂN VẬT PHỤ -->
<div id="peopleModal" class="modal">
  <div class="modal-inner">
    <div class="row">
      <h2>♙ Các mối quan hệ</h2>
      <button onclick="hideModal('peopleModal')">Đóng ✕</button>
    </div>
    <div id="peopleList"></div>
  </div>
</div>

