/* =========================================================
   10. LƯU VÀ KHÔI PHỤC
========================================================= */

function saveGame(silent=false){
  if(!G){
    if(!silent) toast("Bạn chưa bắt đầu cuộc đời.");
    return;
  }

  try{
    const payload={version:4,game:G,stageIndex,selectedChoice};
    localStorage.setItem(SAVE_KEY,JSON.stringify(payload));
    if(!silent) toast("Đã lưu tiến trình.");
  }catch(error){
    if(!silent) toast("Không thể lưu trong trình duyệt hiện tại.");
  }
}

function loadGame(){
  try{
    const raw=localStorage.getItem(SAVE_KEY);
    if(!raw) return false;

    const payload=JSON.parse(raw);
    if(!payload||payload.version!==4||!payload.game) return false;

    G=payload.game;
    stageIndex=Math.max(0,Math.min(STAGES.length,payload.stageIndex||0));
    selectedChoice=payload.selectedChoice??null;

    if(!G.people) G.people={};

    NPC_DEFAULTS.forEach(npc=>{
      if(!G.people[npc.id]){
        G.people[npc.id]={...npc,history:[],present:true};
      }
      updateNPCState(npc.id);
    });

    if(!G.flags) G.flags={};
    if(!G.memories) G.memories=[];
    if(!G.milestones) G.milestones=[];
    if(!G.choices) G.choices={};
    if(!G.dailyLog) G.dailyLog=[];

    document.getElementById("setupScreen").classList.add("hidden");

    if(G.ended){
      document.getElementById("gameScreen").classList.add("hidden");
      document.getElementById("endingScreen").classList.remove("hidden");
      renderEnding();
      return true;
    }

    document.getElementById("endingScreen").classList.add("hidden");
    document.getElementById("gameScreen").classList.remove("hidden");

    showStage();

    if(selectedChoice!==null){
      document.querySelectorAll("#choiceList .choice").forEach((button,index)=>{
        button.disabled=true;
        button.style.opacity=index===selectedChoice?"1":".42";
        button.style.background=index===selectedChoice?"#e2efd9":"#fff";
      });

      document.getElementById("continueBtn").classList.remove("hidden");
      document.getElementById("continueBtn").textContent=
        stageIndex===STAGES.length
          ?"NHÌN LẠI CUỘC ĐỜI →"
          :"TIẾP TỤC HÀNH TRÌNH →";
    }

    renderAll();
    return true;
  }catch(error){
    console.warn("Không thể khôi phục tiến trình:",error);
    return false;
  }
}

/* =========================================================
   11. HỒI KÝ CUỐI ĐỜI
========================================================= */

function finishLife(){
  if(!G||G.ended) return;

  G.ended=true;
  G.age=80;

  addMemory("Chương cuối","Bạn dừng lại để nhìn toàn bộ hành trình đã trải qua.");
  addMilestone("Khép lại hành trình","Những quyết định, mối quan hệ và ký ức đã tạo nên một câu chuyện riêng.");

  saveGame(true);

  document.getElementById("gameScreen").classList.add("hidden");
  document.getElementById("endingScreen").classList.remove("hidden");

  renderEnding();
  window.scrollTo({top:0,behavior:"smooth"});
}

function createMemoir(){
  const selected=Object.entries(G.choices).map(([key,value])=>{
    const stage=[...STAGES,FINAL_STAGE].find(s=>s.key===key);
    const story=[...STAGES,FINAL_STAGE].find(s=>s.key===key);
    const choice=story?.choices.find(c=>c.title===value);

    return {
      age:stage?.age??0,
      title:value,
      outcome:choice?.outcome??""
    };
  }).sort((a,b)=>a.age-b.age);

  const parts=[];

  parts.push(
    `Cuộc đời của ${G.name} bắt đầu trong hoàn cảnh ${G.background}. Với khí chất ${G.temperament}, ${G.name} bước vào thế giới với những điều kiện ban đầu mà bản thân chưa thể lựa chọn.`
  );

  const reflections=[
    ["secureBase","Những năm tháng đầu đời có nền tảng của sự chăm sóc và cảm giác an toàn."],
    ["limitedResources","Hoàn cảnh khiến nhân vật sớm nhận ra rằng nguồn lực có giới hạn và mỗi lựa chọn đều có cái giá riêng."],
    ["friendshipFoundation","Một hành động sẻ chia thời thơ ấu đã góp phần tạo nên nền tảng cho tình bạn."],
    ["resolvedConflict","Trong tuổi thiếu niên, nhân vật từng chọn đối diện một hiểu lầm thay vì để nó hoàn toàn quyết định mối quan hệ."],
    ["decisionFramework","Trước áp lực, nhân vật đã học cách xác định tiêu chí và thời hạn cho quyết định."],
    ["followedDream","Sau kỳ thi, nhân vật quyết định theo đuổi nguyện vọng của mình, chấp nhận cả cơ hội lẫn sự bất định."],
    ["investedInSkills","Nhân vật dành nguồn lực cho việc học thêm, với hy vọng mở rộng những lựa chọn trong tương lai."],
    ["careerAmbition","Trong công việc, nhân vật ưu tiên phát triển và chấp nhận những thử thách lớn hơn."],
    ["familyPriority","Dù bận rộn, nhân vật vẫn có giai đoạn chủ động dành thời gian cho gia đình."],
    ["prioritizedConnection","Một mối quan hệ quan trọng được đặt vào vị trí rõ ràng hơn trong cuộc sống."],
    ["relationshipChanged","Nhân vật từng đối diện với khả năng hai người không còn cùng hướng đi."],
    ["returnedToDream","Ở tuổi trung niên, nhân vật quay lại với một điều từng bị bỏ quên."],
    ["sharedWisdom","Những kinh nghiệm tích lũy được trao lại cho người trẻ, để trải nghiệm cá nhân có thể trở nên hữu ích với người khác."],
    ["slowerLife","Nhân vật lựa chọn một nhịp sống chậm hơn, dành nhiều chỗ cho sức khỏe và sự bình yên."],
    ["wroteMemoir","Nhân vật dành thời gian viết lại câu chuyện của mình, nhận ra rằng ký ức có thể được nhìn theo nhiều cách."],
    ["foundPeace","Nhân vật học cách trân trọng những niềm vui bình dị, không nhất thiết phải biến mọi thứ thành thành tựu."]
  ];

  reflections.forEach(([flag,text])=>{
    if(G.flags[flag]) parts.push(text);
  });

  parts.push(
    "Những quyết định quan trọng trong hành trình:\n"+
    selected.map(item=>`${item.age} tuổi — ${item.title}. ${item.outcome}`).join("\n\n")
  );

  const strongAreas=[];
  if(G.health>=65) strongAreas.push("sức khỏe được duy trì tương đối tốt");
  if(G.mind>=65) strongAreas.push("nguồn lực tinh thần tương đối ổn định");
  if(G.study>=65) strongAreas.push("năng lực học hỏi được phát triển");
  if(G.relation>=65) strongAreas.push("các mối quan hệ xã hội được duy trì");
  if(G.money>=60) strongAreas.push("có một phần nguồn lực tài chính tích lũy");

  if(strongAreas.length){
    parts.push("Khi nhìn lại, những phương diện tương đối vững vàng gồm: "+strongAreas.join(", ")+".");
  }else{
    parts.push("Hành trình có những giới hạn và đánh đổi. Chúng không xóa bỏ những trải nghiệm đã có, nhưng cho thấy rằng một cuộc đời không phải lúc nào cũng diễn ra theo kế hoạch.");
  }

  parts.push(
    "Không có bản hồi ký nào kể hết một con người. Những con số chỉ ghi lại một phần hành trình; ý nghĩa của cuộc đời còn nằm trong điều người khác nhớ về bạn, những gì bạn đã học được và cách bạn đối diện với những lựa chọn của mình."
  );

  return parts.join("\n\n");
}

function renderEnding(){
  if(!G) return;

  document.getElementById("endingTitle").textContent="Cuộc đời của "+G.name;
  document.getElementById("endingSubtitle").textContent=
    "Một hành trình gồm "+G.decisions+" quyết định chính, "+
    G.activities+" hoạt động thường ngày và "+
    G.memories.length+" ký ức được ghi lại.";

  document.getElementById("memoir").textContent=createMemoir();

  const people=document.getElementById("endingPeople");
  people.innerHTML="";

  Object.values(G.people).forEach(person=>{
    const div=document.createElement("div");
    div.className="npc-card";
    div.innerHTML=`
      <div class="npc-head">
        <span>${person.icon} ${esc(person.name)}</span>
        <span>${person.score}/100</span>
      </div>
      <p>${esc(person.status||"Một mối quan hệ đã thay đổi theo thời gian.")}</p>
      <p>${esc(person.description)}</p>`;
    people.appendChild(div);
  });

  const milestones=document.getElementById("endingMilestones");
  milestones.innerHTML="";

  if(!G.milestones.length){
    milestones.innerHTML="<p>Cuộc đời chưa ghi nhận dấu mốc đặc biệt.</p>";
  }else{
    G.milestones.forEach(item=>{
      const div=document.createElement("div");
      div.className="journal-entry";
      div.innerHTML=`
        <small>${item.age} tuổi</small>
        <strong>${esc(item.title)}</strong><br>
        ${esc(item.text)}`;
      milestones.appendChild(div);
    });
  }

  const statData=[
    ["Sức khỏe",G.health+"/100"],
    ["Tinh thần",G.mind+"/100"],
    ["Học tập / kỹ năng",G.study+"/100"],
    ["Quan hệ xã hội",G.relation+"/100"],
    ["Tiền tích lũy",G.money+" xu"],
    ["Kinh nghiệm",G.exp+" XP"],
    ["Quyết định",G.decisions],
    ["Hoạt động thường ngày",G.activities]
  ];

  document.getElementById("endingStats").innerHTML=
    statData.map(([label,value])=>
      `<div class="meta"><span>${esc(label)}</span><strong>${esc(value)}</strong></div>`
    ).join("");
}

/* =========================================================
   12. MODAL, CHƠI LẠI VÀ TIỆN ÍCH
========================================================= */

function openModal(id){
  if(id!=="guideModal"&&!G){
    toast("Hãy bắt đầu cuộc đời trước.");
    return;
  }

  if(id==="journalModal") renderFullJournal();
  if(id==="peopleModal") renderPeople();

  const modal=document.getElementById(id);
  if(modal) modal.classList.remove("hidden");
}

function closeModal(id){
  const modal=document.getElementById(id);
  if(modal) modal.classList.add("hidden");
}

function backdropClose(event,id){
  if(event.target.id===id) closeModal(id);
}

document.addEventListener("keydown",event=>{
  if(event.key==="Escape"){
    ["guideModal","journalModal","peopleModal"].forEach(closeModal);
  }
});

function confirmNewLife(){
  if(!G){
    toast("Bạn chưa bắt đầu cuộc đời.");
    return;
  }

  if(!confirm("Bắt đầu lại từ đầu? Tiến trình hiện tại sẽ bị xóa khỏi bản lưu của game.")){
    return;
  }

  localStorage.removeItem(SAVE_KEY);
  G=null;
  stageIndex=0;
  selectedChoice=null;

  document.getElementById("gameScreen").classList.add("hidden");
  document.getElementById("endingScreen").classList.add("hidden");
  document.getElementById("setupScreen").classList.remove("hidden");

  toast("Bạn có thể tạo một nhân vật mới.");
  window.scrollTo({top:0,behavior:"smooth"});
}

function newLife(){
  if(!confirm("Tạo một cuộc đời mới? Tiến trình cũ sẽ không còn được lưu dưới bản lưu hiện tại.")){
    return;
  }

  localStorage.removeItem(SAVE_KEY);
  G=null;
  stageIndex=0;
  selectedChoice=null;

  document.getElementById("gameScreen").classList.add("hidden");
  document.getElementById("endingScreen").classList.add("hidden");
  document.getElementById("setupScreen").classList.remove("hidden");

  window.scrollTo({top:0,behavior:"smooth"});
}

function toast(message){
  const el=document.getElementById("toast");
  el.textContent=message;
  el.classList.remove("hidden");

  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>el.classList.add("hidden"),2800);
}

