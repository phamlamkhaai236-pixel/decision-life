<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Decision Simulator — Pixel Life</title>

<style>
:root{
  --ink:#302d45;
  --paper:#fffaf0;
  --cream:#f1e5cf;
  --muted:#77738b;
  --pink:#f1b7bd;
  --green:#a9cba4;
  --blue:#acd0e6;
  --yellow:#f4d58b;
  --purple:#c6b3e4;
  --line:#39344d;
  --shadow:5px 5px 0 var(--line);
}

*{box-sizing:border-box}
[hidden],.hidden{display:none!important}

body{
  margin:0;
  color:var(--ink);
  background:#d8e6dc;
  background-image:
    linear-gradient(45deg,#c8dbcf 25%,transparent 25%),
    linear-gradient(-45deg,#c8dbcf 25%,transparent 25%),
    linear-gradient(45deg,transparent 75%,#c8dbcf 75%),
    linear-gradient(-45deg,transparent 75%,#c8dbcf 75%);
  background-size:28px 28px;
  font-family:"Courier New",monospace;
}

button,input,select{font:inherit}

button{
  color:var(--ink);
  border:3px solid var(--line);
  border-radius:0;
  box-shadow:3px 3px 0 var(--line);
  cursor:pointer;
  transition:transform .12s,box-shadow .12s;
}

button:hover{
  transform:translate(-1px,-1px);
  box-shadow:4px 4px 0 var(--line);
}

button:active{
  transform:translate(2px,2px);
  box-shadow:1px 1px 0 var(--line);
}

button:disabled{
  cursor:not-allowed;
  opacity:.48;
  transform:none;
}

button:focus-visible,input:focus-visible,select:focus-visible{
  outline:3px dashed #7463a4;
  outline-offset:3px;
}

.topbar{
  position:sticky;
  top:0;
  z-index:20;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:12px 4%;
  background:var(--paper);
  border-bottom:4px solid var(--line);
}

.brand{font-weight:900;letter-spacing:-1px}
.brand small{
  display:block;
  margin-top:4px;
  color:var(--muted);
  font-size:9px;
  letter-spacing:1px;
}

.top-actions{
  display:flex;
  flex-wrap:wrap;
  gap:7px;
}

.small-btn{
  padding:8px 10px;
  background:var(--yellow);
  font-size:10px;
  font-weight:bold;
}

.wrap{
  width:min(1240px,94%);
  margin:24px auto 50px;
}

.panel{
  min-width:0;
  background:var(--paper);
  border:3px solid var(--line);
  box-shadow:var(--shadow);
}

.setup{
  max-width:700px;
  margin:40px auto;
  padding:28px;
}

.eyebrow{
  color:#81709f;
  font-size:11px;
  font-weight:bold;
  letter-spacing:2px;
  text-transform:uppercase;
}

.setup h1{
  margin:12px 0;
  font-size:clamp(30px,6vw,48px);
  line-height:1.08;
}

.subtitle{
  color:var(--muted);
  font-size:12px;
  line-height:1.8;
  font-family:Arial,sans-serif;
}

.form-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:15px;
  margin:24px 0;
}

.field{
  display:flex;
  flex-direction:column;
  gap:7px;
  font-size:11px;
  font-weight:bold;
}

.field.full{grid-column:1/-1}

.field input,.field select{
  width:100%;
  padding:12px;
  background:white;
  border:2px solid var(--line);
  border-radius:0;
}

.primary{
  width:100%;
  padding:15px;
  background:var(--pink);
  font-weight:900;
}

.game-grid{
  display:grid;
  grid-template-columns:minmax(0,1fr) 300px;
  gap:20px;
  align-items:start;
}

.left-column,.right-column{
  display:grid;
  gap:18px;
  min-width:0;
}

.scene{overflow:hidden}

.scene-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  padding:12px 15px;
  background:#fff2d4;
  border-bottom:3px solid var(--line);
  font-size:10px;
  font-weight:bold;
}

.badge{
  padding:5px 8px;
  background:var(--green);
  border:2px solid var(--line);
  white-space:nowrap;
}

/* PIXEL WORLD */

.world{
  --sky1:#b8d8ee;
  --sky2:#f7dfbc;
  --ground:#9dbd83;
  --hill:#b6d2a0;
  --house:#edc29e;
  --roof:#bd7b7c;
  --sun:#ffdb83;

  position:relative;
  height:320px;
  overflow:hidden;
  isolation:isolate;
  background:linear-gradient(var(--sky1),var(--sky2));
  transition:background .5s;
}

.world.night{
  --sky1:#353c70;
  --sky2:#8f91bd;
  --ground:#657f70;
  --hill:#819b88;
  --house:#b9a0a4;
  --roof:#6b587e;
  --sun:#f4e8b0;
}

.world.school{
  --sky1:#b8dff0;
  --sky2:#f7e3be;
  --ground:#a7c58c;
  --hill:#bed8a8;
}

.world.city{
  --sky1:#edc4ba;
  --sky2:#f8d8b5;
  --ground:#a1a1a0;
  --hill:#b6a5a3;
}

.world.office{
  --sky1:#b7c9e4;
  --sky2:#e8d8d0;
  --ground:#9fae9b;
  --hill:#bdc5b0;
}

.world.old{
  --sky1:#c5c2d9;
  --sky2:#edcfb7;
  --ground:#9da98b;
  --hill:#b7c7a3;
}

.sun{
  position:absolute;
  top:35px;
  right:14%;
  width:35px;
  height:35px;
  background:var(--sun);
  box-shadow:0 -7px var(--sun),0 7px var(--sun),
             7px 0 var(--sun),-7px 0 var(--sun);
}

.cloud{
  position:absolute;
  top:63px;
  left:12%;
  width:40px;
  height:13px;
  background:#fffaf0;
  box-shadow:10px -9px #fffaf0,23px -9px #fffaf0,34px 0 #fffaf0;
  animation:cloudMove 18s linear infinite alternate;
}

.cloud.two{
  top:110px;
  left:55%;
  transform:scale(.65);
  animation-duration:25s;
}

@keyframes cloudMove{
  from{translate:-10px 0}
  to{translate:28px 0}
}

.hill{
  position:absolute;
  z-index:-1;
  bottom:63px;
  left:-10%;
  width:120%;
  height:105px;
  border-radius:50% 50% 0 0;
  background:var(--ground);
}

.hill.back{
  bottom:82px;
  left:28%;
  background:var(--hill);
}

.ground{
  position:absolute;
  bottom:0;
  left:0;
  width:100%;
  height:70px;
  border-top:5px solid #597b5c;
  background-color:var(--ground);
  background-image:
    linear-gradient(90deg,transparent 50%,#00000008 50%),
    linear-gradient(transparent 50%,#00000008 50%);
  background-size:28px 28px;
}

.path{
  position:absolute;
  bottom:0;
  left:42%;
  width:90px;
  height:100px;
  background:#e7c99e;
  clip-path:polygon(35% 0,65% 0,100% 100%,0 100%);
}

.house{
  position:absolute;
  bottom:68px;
  left:10%;
  width:105px;
  height:83px;
  background:var(--house);
  border:4px solid #493b50;
}

.roof{
  position:absolute;
  top:-33px;
  left:-12px;
  width:121px;
  height:36px;
  background:var(--roof);
  border:4px solid #493b50;
  clip-path:polygon(50% 0,100% 100%,0 100%);
}

.window{
  position:absolute;
  top:14px;
  left:12px;
  width:23px;
  height:24px;
  background:#a8d8e8;
  border:3px solid #493b50;
  box-shadow:31px 0 #a8d8e8,31px 0 0 3px #493b50;
}

.door{
  position:absolute;
  right:10px;
  bottom:0;
  width:23px;
  height:38px;
  background:#a17b67;
  border:3px solid #493b50;
}

.tree{
  position:absolute;
  right:13%;
  bottom:67px;
  width:17px;
  height:52px;
  background:#8c664d;
}

.tree::before{
  content:"";
  position:absolute;
  bottom:29px;
  left:-19px;
  width:55px;
  height:47px;
  background:#659269;
  box-shadow:8px -12px #82ad7c;
}

.tree::after{
  content:"";
  position:absolute;
  top:3px;
  left:-9px;
  width:35px;
  height:14px;
  background:#90bd87;
}

.pixel-person{
  position:absolute;
  z-index:4;
  bottom:67px;
  left:48%;
  width:23px;
  height:41px;
  background:#727ca9;
  box-shadow:0 -21px 0 -3px #e8b990,
    0 -28px 0 -5px #493b50,
    -6px -20px 0 -5px #493b50,
    6px -20px 0 -5px #493b50,
    -5px 39px 0 -4px #493b50,
    5px 39px 0 -4px #493b50;
  transition:left .4s;
}

.pixel-person::before{
  content:"";
  position:absolute;
  top:-17px;
  left:4px;
  width:3px;
  height:3px;
  background:#493b50;
  box-shadow:9px 0 #493b50;
}

.world.school .house{
  left:17%;
  width:135px;
  height:98px;
  background:#e5bd8e;
}

.world.school .roof{
  background:#7f91b5;
  width:151px;
}

.world.city .house{
  left:8%;
  bottom:69px;
  width:75px;
  height:130px;
  background:#8d9dbb;
}

.world.city .roof{
  top:-8px;
  left:-4px;
  width:75px;
  height:12px;
  background:#655a7c;
  clip-path:none;
}

.world.city .window{
  top:20px;
  left:12px;
  width:15px;
  height:20px;
  box-shadow:27px 0 #a8d8e8,0 30px #a8d8e8,27px 30px #a8d8e8;
}

.world.city .door{display:none}
.world.city .tree{right:8%}

.world.office .house{
  left:12%;
  width:130px;
  height:115px;
  background:#b9c5c8;
}

.world.office .roof{
  top:-9px;
  left:-4px;
  width:130px;
  height:13px;
  background:#737e9a;
  clip-path:none;
}

.world.office .door{display:none}

.world.old .house{
  left:12%;
  width:115px;
  height:76px;
  background:#d6bb9b;
}

.world.old .roof{background:#a58b9a}
.world.old .tree{right:20%}

.scene-caption{
  position:absolute;
  z-index:5;
  left:12px;
  bottom:12px;
  max-width:75%;
  padding:8px 10px;
  background:#fffaf0ed;
  border:2px solid var(--line);
  font-size:10px;
  font-weight:bold;
}

.scene-content{padding:20px}

.scene-content h2{
  margin:0 0 12px;
  font-size:clamp(22px,3vw,30px);
  line-height:1.2;
}

.story-text{
  color:#59566d;
  font-family:Arial,sans-serif;
  font-size:15px;
  line-height:1.85;
  white-space:pre-line;
}

.event-box{
  margin:15px 0;
  padding:12px 14px;
  border-left:5px solid #e4b962;
  background:#f7edcf;
  color:#57516b;
  font-family:Arial,sans-serif;
  font-size:13px;
  line-height:1.65;
  white-space:pre-line;
}

.section-title{
  margin:20px 0 10px;
  font-size:12px;
  font-weight:900;
}

.choice-list{display:grid;gap:10px}

.choice{
  display:grid;
  grid-template-columns:36px 1fr;
  align-items:start;
  gap:12px;
  padding:13px;
  text-align:left;
  background:#fff;
}

.choice:hover{background:#fff4dd}

.choice-num{
  display:grid;
  place-items:center;
  width:32px;
  height:32px;
  border:2px solid var(--line);
  background:var(--purple);
  font-weight:900;
}

.choice strong{display:block;margin-bottom:5px;font-size:12px}

.choice small{
  display:block;
  color:var(--muted);
  font-family:Arial,sans-serif;
  font-size:12px;
  line-height:1.55;
}

.choice .hint{
  display:block;
  margin-top:6px;
  color:#6c815f;
  font-size:10px;
}

.continue{
  width:100%;
  margin-top:15px;
  padding:14px;
  background:var(--green);
  font-weight:900;
}

.daily-panel{padding:17px}

.panel-title{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  padding-bottom:12px;
  margin-bottom:14px;
  border-bottom:2px dashed #d6cdbb;
  font-size:12px;
  font-weight:900;
}

.daily-description{
  margin-bottom:14px;
  color:var(--muted);
  font-family:Arial,sans-serif;
  font-size:12px;
  line-height:1.65;
}

.daily-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:10px;
}

.daily-card{
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  gap:7px;
  padding:12px;
  text-align:left;
  background:#fff;
}

.daily-card .icon{font-size:22px}
.daily-card strong{font-size:11px}

.daily-card small{
  color:var(--muted);
  font-family:Arial,sans-serif;
  font-size:11px;
  line-height:1.5;
}

.daily-card .cost{color:#7e6a96;font-size:10px;font-weight:bold}
.daily-card.done{background:#e1ecd8}

.side-panel{padding:16px}

.player-card{
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:16px;
}

.avatar{
  display:grid;
  place-items:center;
  flex-shrink:0;
  width:48px;
  height:48px;
  border:3px solid var(--line);
  background:#f4c6a5;
  font-size:22px;
}

.player-name{font-weight:900}
.player-sub{margin-top:5px;color:var(--muted);font-size:10px}

.stat{margin:14px 0}

.stat-label{
  display:flex;
  justify-content:space-between;
  gap:8px;
  margin-bottom:6px;
  font-size:10px;
  font-weight:bold;
}

.bar{
  height:12px;
  overflow:hidden;
  border:2px solid var(--line);
  background:#e8dfd1;
}

.fill{width:50%;height:100%;transition:width .3s}
.health-fill{background:#9ecb9a}
.mind-fill{background:#c4b1e5}
.study-fill{background:#9dc9e5}
.relation-fill{background:#efb2b2}

.meta-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
  margin-top:15px;
}

.meta{
  min-width:0;
  padding:10px;
  background:#f6eddc;
  border:2px solid #d5c8b0;
}

.meta span{
  display:block;
  margin-bottom:5px;
  color:var(--muted);
  font-size:9px;
}

.meta strong{font-size:13px;overflow-wrap:anywhere}

.relationship-list,.journal-list{display:grid;gap:10px}

.npc-card{
  padding:10px;
  background:#fff;
  border:2px solid #e2d8c8;
}

.npc-head{
  display:flex;
  justify-content:space-between;
  gap:8px;
  font-size:11px;
  font-weight:bold;
}

.npc-card p{
  margin:7px 0;
  color:var(--muted);
  font-family:Arial,sans-serif;
  font-size:11px;
  line-height:1.5;
}

.npc-bar{height:8px;border:1px solid var(--line);background:#eee4d8}
.npc-bar div{height:100%;background:#e9aaa9}

.journal-entry{
  padding:10px;
  border-left:4px solid var(--purple);
  background:#fff;
  font-family:Arial,sans-serif;
  font-size:12px;
  line-height:1.6;
  overflow-wrap:anywhere;
}

.journal-entry small{
  display:block;
  margin-bottom:4px;
  color:var(--muted);
}

.progress-track{
  height:12px;
  border:2px solid var(--line);
  background:#e8dfd1;
}

.progress-fill{
  width:0;
  height:100%;
  background:#9ecb9a;
  transition:width .4s;
}

.notice{
  padding:11px;
  background:#fff2d4;
  border:2px dashed #d5b36f;
  font-size:11px;
  line-height:1.65;
}

/* MODALS */

.modal{
  position:fixed;
  inset:0;
  z-index:50;
  display:grid;
  place-items:center;
  padding:18px;
  background:#28263dcc;
}

.modal-box{
  width:min(760px,100%);
  max-height:88vh;
  overflow:auto;
  padding:22px;
  background:var(--paper);
  border:4px solid var(--line);
  box-shadow:8px 8px 0 #28263d;
}

.modal-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  margin-bottom:18px;
}

.modal-head h2{margin:0;font-size:21px}
.close{padding:7px 10px;background:var(--pink)}

.guide-content{
  font-family:Arial,sans-serif;
  font-size:14px;
  line-height:1.8;
}

.guide-content h3{
  margin-top:22px;
  padding-bottom:7px;
  border-bottom:2px dashed #d6cdbb;
  font-family:"Courier New",monospace;
  font-size:14px;
}

.guide-content li{margin:6px 0}
.guide-step{
  padding:12px;
  margin:10px 0;
  background:#fff2d4;
  border-left:5px solid #e4b962;
}

.guide-tip{
  padding:12px;
  background:#e1ecd8;
  border:2px dashed #9bb893;
}

.ending{
  max-width:850px;
  margin:20px auto;
  padding:28px;
}

.ending h1{
  font-size:clamp(30px,5vw,48px);
  line-height:1.1;
}

.memoir{
  margin:20px 0;
  padding:22px;
  border:2px dashed #b9a587;
  background:#fff3d8;
  font-family:Georgia,serif;
  font-size:15px;
  line-height:1.95;
  white-space:pre-line;
}

.ending-section{margin:22px 0}
.ending-section h3{font-size:13px}

.ending-section p{
  font-family:Arial,sans-serif;
  font-size:13px;
  line-height:1.8;
}

.toast{
  position:fixed;
  z-index:80;
  left:50%;
  bottom:20px;
  transform:translateX(-50%);
  max-width:90%;
  padding:12px 16px;
  border:3px solid var(--line);
  background:var(--paper);
  box-shadow:4px 4px 0 var(--line);
  font-size:11px;
  font-weight:bold;
}

.footer{
  margin-top:28px;
  text-align:center;
  color:var(--muted);
  font-size:10px;
  line-height:1.9;
}

@media(max-width:900px){
  .game-grid{grid-template-columns:1fr}
  .right-column{grid-template-columns:1fr 1fr;align-items:start}
  .right-column .side-panel:first-child{grid-column:1/-1}
}

@media(max-width:580px){
  .topbar{align-items:flex-start}
  .top-actions{max-width:190px}
  .small-btn{padding:7px;font-size:9px}
  .setup{padding:20px;margin:20px auto}
  .form-grid{grid-template-columns:1fr}
  .field.full{grid-column:auto}
  .world{height:255px}
  .scene-content{padding:15px}
  .story-text{font-size:14px}
  .right-column{grid-template-columns:1fr}
  .daily-grid{grid-template-columns:1fr 1fr}
  .ending{padding:19px}
  .modal-box{padding:16px}
}

@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{
    animation-duration:.01ms!important;
    transition-duration:.01ms!important;
    scroll-behavior:auto!important;
  }
}
</style>
</head>

<body>

<header class="topbar">
  <div class="brand">
    DECISION SIMULATOR
    <small>PIXEL LIFE · YOUR LIFE, YOUR STORY</small>
  </div>

  <div class="top-actions">
    <button class="small-btn" onclick="openModal('guideModal')">❔ HƯỚNG DẪN</button>
    <button class="small-btn" onclick="saveGame()">💾 LƯU GAME</button>
    <button class="small-btn" onclick="openModal('journalModal')">📖 NHẬT KÝ</button>
    <button class="small-btn" onclick="openModal('peopleModal')">👥 NHÂN VẬT</button>
    <button class="small-btn" onclick="confirmNewLife()">↻ CHƠI LẠI</button>
  </div>
</header>

<main class="wrap">

<section id="setupScreen" class="setup panel">
  <div class="eyebrow">A life simulation game</div>
  <h1>Một cuộc đời.<br>Hàng nghìn khả năng.</h1>

  <p class="subtitle">
    Bạn không chọn được nơi mình bắt đầu. Nhưng những gì bạn làm
    với thời gian, cơ hội và các mối quan hệ sẽ góp phần định hình
    con người mà bạn trở thành.
  </p>

  <div class="form-grid">
    <label class="field full">
      TÊN NHÂN VẬT
      <input id="setupName" maxlength="24" value="An" placeholder="Nhập tên nhân vật">
    </label>

    <label class="field">
      GIỚI TÍNH NHÂN VẬT
      <select id="setupGender">
        <option value="nữ">Nữ</option>
        <option value="nam">Nam</option>
        <option value="khác">Khác</option>
      </select>
