/* =========================================================
   2. TRẠNG THÁI VÀ TIỆN ÍCH
========================================================= */

let G=null;
let stageIndex=0;
let selectedChoice=null;
let toastTimer=null;

function clamp(value,min=0,max=100){
  return Math.max(min,Math.min(max,Math.round(Number(value)||0)));
}

function esc(value){
  return String(value??"").replace(/[&<>"']/g,char=>({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  }[char]));
}

function currentStage(){
  return stageIndex>=STAGES.length ? FINAL_STAGE : STAGES[stageIndex];
}

function currentStory(){
  return currentStage();
}

function createGame(config){
  const people={};

  NPC_DEFAULTS.forEach(npc=>{
    people[npc.id]={...npc,history:[],present:true,status:"Có khoảng cách"};
  });

  let startingMoney=25;
  if(config.background==="khó khăn") startingMoney=10;
  if(config.background==="khá giả") startingMoney=50;
  if(config.difficulty==="thử thách") startingMoney=Math.max(5,startingMoney-10);

  return {
    version:4,
    name:config.name||"An",
    gender:config.gender,
    temperament:config.temperament,
    background:config.background,
    difficulty:config.difficulty,
    age:0,
    day:1,
    health:70,
    mind:70,
    study:20,
    relation:50,
    money:startingMoney,
    exp:0,
    decisions:0,
    activities:0,
    flags:{},
    people,
    memories:[],
    milestones:[],
    choices:{},
    dailyUsed:0,
    dailyLog:[],
    lastOutcome:"",
    currentEvent:"",
    ended:false
  };
}

function addMemory(title,text){
  if(!G) return;

  G.memories.unshift({
    id:"m_"+Date.now()+"_"+Math.random().toString(36).slice(2,7),
    age:G.age,
    day:G.day,
    title,
    text,
    date:new Date().toLocaleDateString("vi-VN")
  });

  if(G.memories.length>200) G.memories.pop();
}

function addMilestone(title,text){
  if(!G) return;
  if(G.milestones.some(item=>item.title===title)) return;
  G.milestones.unshift({age:G.age,title,text});
}

function applyEffects(effects){
  Object.entries(effects||{}).forEach(([key,value])=>{
    if(key==="money"||key==="exp"){
      G[key]=Math.max(0,Math.round((G[key]||0)+value));
    }else if(["health","mind","study","relation"].includes(key)){
      G[key]=clamp(G[key]+value);
    }
  });
}

function changeRelationship(id,delta,reason){
  const person=G.people[id];
  if(!person) return;

  person.score=clamp(person.score+delta);
  person.history.push({age:G.age,delta,reason});

  if(person.history.length>50) person.history.shift();

  updateNPCState(id);
}

function updateNPCState(id){
  const person=G.people[id];
  if(!person) return;

  if(person.score>=75) person.status="Gắn bó sâu sắc";
  else if(person.score>=55) person.status="Tin tưởng";
  else if(person.score>=35) person.status="Có khoảng cách";
  else person.status="Xa cách";

  person.present=person.score>15;
}

/* =========================================================
   3. BẮT ĐẦU GAME
========================================================= */

function startGame(){
  const config={
    name:document.getElementById("setupName").value.trim()||"An",
    gender:document.getElementById("setupGender").value,
    temperament:document.getElementById("setupTemperament").value,
    background:document.getElementById("setupBackground").value,
    difficulty:document.getElementById("setupDifficulty").value
  };

  G=createGame(config);
  stageIndex=0;
  selectedChoice=null;

  document.getElementById("setupScreen").classList.add("hidden");
  document.getElementById("endingScreen").classList.add("hidden");
  document.getElementById("gameScreen").classList.remove("hidden");

  addMemory("Khởi đầu","Cuộc đời của "+G.name+" bắt đầu trong hoàn cảnh "+G.background+".");
  addMilestone("Bắt đầu cuộc đời","Một hành trình mới đã mở ra.");

  applyStageStart();
  showStage();
  renderAll();
  saveGame(true);
  window.scrollTo({top:0,behavior:"smooth"});
}

function applyStageStart(){
  const stage=currentStage();
  G.age=stage.age;
  G.dailyUsed=0;
  G.dailyLog=[];

  if(stage.key==="school"&&G.flags.curiosity) G.study=clamp(G.study+2);
  if(stage.key==="work"&&G.flags.investedInSkills) G.study=clamp(G.study+3);

  if(stage.key==="love"&&G.flags.careerAmbition&&G.health<50){
    G.currentEvent="Bạn đã dành nhiều sức lực cho công việc. Hãy cân nhắc sức khỏe khi bước vào giai đoạn mới.";
  }else{
    G.currentEvent="";
  }
}

/* =========================================================
   4. HIỂN THỊ CHƯƠNG VÀ LỰA CHỌN
========================================================= */

function showStage(){
  if(!G||G.ended) return;

  const stage=currentStage();
  G.age=stage.age;

  document.getElementById("chapterLabel").textContent=stage.label;
  document.getElementById("ageBadge").textContent=stage.age+" TUỔI";
  document.getElementById("sceneCaption").textContent=stage.caption;

  const world=document.getElementById("world");
  world.classList.remove("night","school","city","office","old");

  if(stageIndex>=8) world.classList.add("night");
  if(stage.scene==="school") world.classList.add("school");
  if(stage.scene==="city") world.classList.add("city");
  if(stage.scene==="office") world.classList.add("office");
  if(stage.scene==="old") world.classList.add("old");

  document.getElementById("pixelPerson").style.left=(30+(stageIndex%5)*9)+"%";
  document.getElementById("sceneTitle").textContent=stage.title;
  document.getElementById("sceneText").textContent=stage.text(G);

  const eventText=typeof stage.event==="function"?stage.event(G):stage.event;
  const extra=G.currentEvent?"\n\n"+G.currentEvent:"";
  document.getElementById("eventBox").textContent=
    (G.lastOutcome?"HỆ QUẢ TỪ LỰA CHỌN TRƯỚC\n"+G.lastOutcome+"\n\n":"")
    +eventText+extra;

  renderChoices();
  renderDaily();

  const continueBtn=document.getElementById("continueBtn");
  continueBtn.classList.add("hidden");
  selectedChoice=null;
}

function renderChoices(){
  const container=document.getElementById("choiceList");
  container.innerHTML="";

  currentStory().choices.forEach((choice,index)=>{
    const button=document.createElement("button");
    button.className="choice";

    const num=document.createElement("span");
    num.className="choice-num";
    num.textContent=String(index+1);

    const content=document.createElement("span");
    const strong=document.createElement("strong");
    strong.textContent=choice.title;

    const small=document.createElement("small");
    small.textContent=choice.desc;

    content.append(strong,small);
    button.append(num,content);
    button.addEventListener("click",()=>chooseStory(index));
    container.appendChild(button);
  });
}

function chooseStory(index){
  if(!G||G.ended||selectedChoice!==null) return;

  const story=currentStory();
  const choice=story.choices[index];
  if(!choice) return;

  selectedChoice=index;
  G.decisions++;

  applyEffects(choice.effects);

  Object.entries(choice.relations||{}).forEach(([id,delta])=>{
    changeRelationship(id,delta,story.title);
  });

  Object.entries(choice.flags||{}).forEach(([key,value])=>{
    G.flags[key]=value;
  });

  G.choices[story.key]=choice.title;
  G.lastOutcome=choice.outcome;

  addMemory(story.title,"Bạn chọn: "+choice.title+". "+choice.outcome);

  if(G.flags.resolvedConflict&&G.flags.decisionFramework){
    addMilestone("Học cách đối diện","Bạn đã đối diện một hiểu lầm và xây dựng cách quyết định có mục tiêu.");
  }

  if(G.flags.followedDream&&G.flags.investedInSkills){
    addMilestone("Đầu tư cho con đường riêng","Bạn vừa theo đuổi điều mình muốn, vừa dành nguồn lực để phát triển năng lực.");
  }

  if(G.flags.familyPriority&&G.flags.prioritizedConnection){
    addMilestone("Không chỉ sống vì công việc","Bạn đã chủ động dành thời gian cho công việc và những mối quan hệ quan trọng.");
  }

  if(G.flags.wroteMemoir){
    addMilestone("Người kể chuyện cuộc đời mình","Bạn đã dành thời gian nhìn lại hành trình qua những ký ức.");
  }

  if(G.flags.sharedWisdom){
    addMilestone("Trao lại kinh nghiệm","Bạn đã dùng trải nghiệm của mình để giúp người khác.");
  }

  if(G.flags.foundPeace){
    addMilestone("Tìm thấy bình yên","Bạn dành chỗ cho những niềm vui bình dị.");
  }

  document.querySelectorAll("#choiceList .choice").forEach((button,i)=>{
    button.disabled=true;
    button.style.opacity=i===index?"1":".42";
    button.style.background=i===index?"#e2efd9":"#fff";
  });

  document.getElementById("eventBox").textContent=
    "BẠN ĐÃ CHỌN: "+choice.title+"\n\n"+choice.outcome+
    "\n\nHãy quan sát sự thay đổi ở các chỉ số bên cạnh. Một lựa chọn có thể đem lại lợi ích ở phương diện này nhưng tạo ra đánh đổi ở phương diện khác.";

  const next=document.getElementById("continueBtn");
  next.classList.remove("hidden");
  next.textContent=stageIndex===STAGES.length
    ?"NHÌN LẠI CUỘC ĐỜI →"
    :"TIẾP TỤC HÀNH TRÌNH →";

  renderAll();
  saveGame(true);
}

/* =========================================================
   5. HOẠT ĐỘNG HẰNG NGÀY
========================================================= */

function renderDaily(){
  if(!G) return;

  const container=document.getElementById("dailyGrid");
  container.innerHTML="";

  const key=currentStage().key;

  document.getElementById("dailyCounter").textContent=G.dailyUsed+" / 2 hoạt động";
  document.getElementById("dailyDescription").textContent=
    G.dailyUsed>=2
      ?"Bạn đã sử dụng hết lượt hoạt động của chương này. Hãy cân nhắc quyết định chính."
      :"Bạn còn "+(2-G.dailyUsed)+" lượt hoạt động. Bạn có thể bỏ qua nếu muốn chuyển thẳng đến quyết định chính.";

  DAILY.forEach(action=>{
    if(!action.allowed.includes(key)) return;

    const button=document.createElement("button");
    button.className="daily-card";

    const alreadyUsed=G.dailyLog.some(item=>item.id===action.id);
    const disabled=G.dailyUsed>=2||G.money<action.cost||selectedChoice!==null;

    button.disabled=disabled;
    if(alreadyUsed) button.classList.add("done");

    button.innerHTML=`
      <span class="icon">${action.icon}</span>
      <strong>${esc(action.title)}</strong>
      <small>${esc(action.desc)}</small>
      <span class="cost">${action.cost===0?"Không tốn tiền":"Chi phí: "+action.cost+" xu"}</span>`;

    button.addEventListener("click",()=>doDaily(action.id));
    container.appendChild(button);
  });
}

function doDaily(id){
  if(!G||G.ended||selectedChoice!==null) return;

  if(G.dailyUsed>=2){
    toast("Bạn đã sử dụng hết lượt hoạt động của chương này.");
    return;
  }

  const action=DAILY.find(item=>item.id===id);
  if(!action) return;

  if(!action.allowed.includes(currentStage().key)){
    toast("Hoạt động này chưa phù hợp với giai đoạn hiện tại.");
    return;
  }

  if(G.money<action.cost){
    toast("Bạn chưa đủ tiền cho hoạt động này.");
    return;
  }

  G.money-=action.cost;
  applyEffects(action.effects);

  G.dailyUsed++;
  G.activities++;
  G.day++;

  G.dailyLog.push({id:action.id,title:action.title,result:action.result});
  addMemory("Hoạt động thường ngày: "+action.title,action.result);

  renderAll();
  saveGame(true);
  toast(action.result);
}

/* =========================================================
   6. CHUYỂN CHƯƠNG
========================================================= */

function continueStory(){
  if(!G||selectedChoice===null||G.ended) return;

  if(stageIndex>=STAGES.length){
    finishLife();
    return;
  }

  const nextIndex=stageIndex+1;

  if(nextIndex>STAGES.length){
    finishLife();
    return;
  }

  stageIndex=nextIndex;
  applyStageStart();
  showStage();
  renderAll();
  saveGame(true);

  window.scrollTo({top:0,behavior:"smooth"});
}

