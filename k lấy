 // ambient top label
 x.textAlign='left';x.fillStyle='#315b4a';x.font='bold 12px system-ui';x.fillText(G.environment==='coastal'?'LÀNG VEN SÔNG':G.environment==='mountain'?'THUNG LŨNG':'KHU PHỐ CỦA BẠN',18,22);
}
function nearestPlaceId(){let ps=CHAPTERS[G.chapter].places;let found=ps.map(id=>({id,d:Math.hypot(player.x-PLACE[id].x,player.y-PLACE[id].y)})).sort((a,b)=>a.d-b.d)[0];return found&&found.d<95?found.id:null}
function move(dx,dy){if(!G)return;player.x=Math.max(25,Math.min(875,player.x+dx*18));player.y=Math.max(35,Math.min(405,player.y+dy*18));let near=nearestPlaceId();document.getElementById('worldMessage').textContent=near?`Bạn đang ở gần ${PLACE[near].name}. Nhấn E hoặc TƯƠNG TÁC.`:'Đang khám phá… Hãy đến gần một địa điểm.';drawWorld()}
function interact(id){if(!G)return;id=id||nearestPlaceId();if(!id){document.getElementById('worldMessage').textContent='Bạn cần đến gần một địa điểm để tương tác.';return}let ch=CHAPTERS[G.chapter];let key=nextEventForChapter();if(!key){document.getElementById('worldMessage').textContent='Bạn đã khám phá xong câu chuyện chính ở giai đoạn này. Hãy tiếp tục sang giai đoạn mới.';return}let ev=EVENTS[key];if(ev.place!==id){document.getElementById('worldMessage').textContent=`Ở ${PLACE[id].name} chưa có tình huống chính đang chờ. Hãy tìm đến ${PLACE[ev.place].name} để tiếp tục câu chuyện, hoặc khám phá nơi này rồi quay lại.`;return}if(activeEvent&&activeEvent.key===key&&activeEvent.step>0){renderEvent();return}activeEvent={key,step:0,place:id};document.getElementById('locationLabel').textContent='📍 '+PLACE[id].name;document.getElementById('worldMessage').textContent='Bạn đã tương tác tại '+PLACE[id].name+'.';renderEvent()}
function nextEventForChapter(){let ch=CHAPTERS[G.chapter];return ch.events.find(k=>!G.flags[k+'_done'])}
function renderEvent(){let ev=EVENTS[activeEvent.key];document.getElementById('eventIcon').textContent=ev.icon;document.getElementById('eventTitle').textContent=ev.title;document.getElementById('eventAge').textContent=CHAPTERS[G.chapter].label;document.getElementById('eventStory').textContent=ev.story(G);let npc=NPCS[ev.npc];let npcLine=document.getElementById('npcLine');npcLine.classList.remove('hidden');npcLine.textContent=`${npc.icon} ${npc.name}: “${npcLineFor(ev,G)}”`;let area=document.getElementById('choiceArea');area.innerHTML='<div class="eyebrow">BẠN SẼ LỰA CHỌN NHƯ THẾ NÀO?</div><div class="choices" id="choices"></div>';let choices=ev.choices;choices.forEach((ch,i)=>{let b=document.createElement('button');b.className='choice';b.innerHTML=`<span class="num">${i+1}</span><span><strong>${ch[0]}</strong><small>${ch[2]}</small></span>`;b.onclick=()=>choose(ch);document.getElementById('choices').appendChild(b)});document.getElementById('outcome').classList.add('hidden');document.getElementById('nextChapter').classList.add('hidden')}
function npcLineFor(ev,s){if(ev.npc==='friend')return 'Mình thử nghĩ xem phương án nào hợp với cả hai nhé?';if(ev.npc==='teacher')return 'Em có thể chọn cách phù hợp với mình, miễn là hiểu vì sao.';if(ev.npc==='mentor')return 'Hãy xem điều kiện, mục tiêu và thông tin mình đang có.';if(ev.npc==='shopkeeper')return 'Con cứ xem kỹ rồi quyết định, không cần vội.';return 'Mình sẽ cùng tìm cách phù hợp.'}
function choose(ch){if(!G||!activeEvent)return;let [label,effects,feedback,next]=ch;Object.entries(effects).forEach(([k,v])=>{if(typeof G[k]==='number')G[k]=clamp(G[k]+v)});G.decisions++;G.flags[activeEvent.key+'_done']=true;G.tags.push(label);if(activeEvent.key==='purchase'){if(label.startsWith('Mua ngay'))G.tags.push('purchase_bought');else if(label.startsWith('Chưa mua'))G.tags.push('purchase_saved')}if(activeEvent.key==='pathway'){G.school=label}if(activeEvent.key==='firstjob'){G.flags.jobPath=label}let nextKey=next;if(nextKey==='career_pick'){activeEvent={key:'career_pick',step:0,place:'careercenter'};showCareerPicker();logDecision(label,feedback);render();return}if(nextKey==='school_route'){G.flags.schoolRoute=true}logDecision(label,feedback);document.getElementById('npcLine').classList.add('hidden');document.getElementById('eventTitle').textContent='Hệ quả của lựa chọn';document.getElementById('eventStory').textContent=feedback;document.getElementById('choiceArea').innerHTML='<div class="muted">Lựa chọn đã được ghi vào nhật ký.</div>';let out=document.getElementById('outcome');out.classList.remove('hidden');out.textContent=feedback+'\n\nTình huống tiếp theo sẽ tiếp tục tại '+PLACE[EVENTS[nextKey]?.place||activeEvent.place].name+'.';if(nextKey==='END'){document.getElementById('nextChapter').classList.remove('hidden');document.getElementById('nextChapter').textContent='Xem tổng kết cuộc đời →';document.getElementById('nextChapter').onclick=finish;activeEvent=null}else if(nextKey==='RESTART'){document.getElementById('nextChapter').classList.remove('hidden');document.getElementById('nextChapter').textContent='Tạo cuộc đời mới →';document.getElementById('nextChapter').onclick=resetGame;activeEvent=null}else if(nextKey==='NEXT_CHAPTER'){activeEvent=null;document.getElementById('nextChapter').classList.remove('hidden');document.getElementById('nextChapter').textContent='Tiếp tục giai đoạn →';document.getElementById('nextChapter').onclick=advanceChapter}else{activeEvent={key:nextKey,step:0,place:EVENTS[nextKey]?.place||activeEvent.place};document.getElementById('nextChapter').classList.remove('hidden');document.getElementById('nextChapter').textContent='Tiếp tục câu chuyện →';document.getElementById('nextChapter').onclick=()=>{let ev=EVENTS[activeEvent.key];if(ev){player.x=PLACE[ev.place].x;player.y=PLACE[ev.place].y;drawWorld();document.getElementById('locationLabel').textContent='📍 '+PLACE[ev.place].name;renderEvent()}}}render()}
function showCareerPicker(){document.getElementById('eventIcon').textContent='🧭';document.getElementById('eventTitle').textContent='Chọn lĩnh vực nghề nghiệp';document.getElementById('eventAge').textContent='Định hướng cá nhân';document.getElementById('eventStory').textContent='Chọn một lĩnh vực để mở tuyến trải nghiệm riêng. Đây không phải lựa chọn cố định suốt đời; bạn có thể điều chỉnh khi có thêm thông tin và trải nghiệm.';let area=document.getElementById('choiceArea');area.innerHTML='<div class="careergrid" id="careerGrid"></div>';CAREERS.forEach((c,i)=>{let b=document.createElement('button');b.className='careerbtn';b.innerHTML=`${c.emoji} ${c.name}<small>${c.field}</small>`;b.onclick=()=>selectCareer(i);document.getElementById('careerGrid').appendChild(b)});document.getElementById('nextChapter').classList.add('hidden')}
function selectCareer(i){let c=CAREERS[i];G.career=c.name;G.careerId=c.id;careerIndex=i;careerStep=0;activeEvent={key:'career',step:0,place:'work'};logDecision('Định hướng nghề: '+c.name,'Bạn chọn tìm hiểu tuyến '+c.name+'.');renderCareerEvent()}
function renderCareerEvent(){activeEvent={key:'career',step:careerStep,place:'work'};let c=CAREERS[careerIndex],e=c.events[careerStep];document.getElementById('eventIcon').textContent=c.emoji;document.getElementById('eventTitle').textContent=e[0];document.getElementById('eventAge').textContent=['18–22 tuổi','22–25 tuổi','25–35 tuổi'][careerStep]||'Phát triển nghề';document.getElementById('eventStory').textContent=c.start+'\n\n'+e[1];document.getElementById('locationLabel').textContent='📍 '+(careerStep===0?'Khu học tập':careerStep===1?'Nơi làm việc':'Không gian nghề nghiệp');document.getElementById('choiceArea').innerHTML='<div class="eyebrow">LỰA CHỌN TRONG TUYẾN NGHỀ</div><div class="choices" id="careerChoices"></div>';e[2].forEach((opt,j)=>{let b=document.createElement('button');b.className='choice';b.innerHTML=`<span class="num">${j+1}</span><span><strong>${opt[0]}</strong><small>${opt[2]}</small></span>`;b.onclick=()=>{Object.entries(opt[1]).forEach(([k,v])=>{if(typeof G[k]==='number')G[k]=clamp(G[k]+v)});G.decisions++;logDecision(opt[0],opt[2]);careerStep++;if(careerStep<c.events.length)renderCareerEvent();else{activeEvent=null;document.getElementById('eventTitle').textContent='Tuyến nghề đã mở ra';document.getElementById('eventStory').textContent=`Bạn đã trải qua ba cột mốc đầu tiên của lĩnh vực ${c.name}. Những lựa chọn nghề nghiệp có thể tiếp tục thay đổi theo trải nghiệm và điều kiện thực tế.`;document.getElementById('choiceArea').innerHTML='<div class="muted">Bạn có thể tiếp tục hành trình cuộc đời.</div>';document.getElementById('nextChapter').classList.remove('hidden');document.getElementById('nextChapter').textContent='Tiếp tục cuộc đời →';document.getElementById('nextChapter').onclick=()=>advanceChapter()}render()};document.getElementById('careerChoices').appendChild(b)});document.getElementById('nextChapter').classList.add('hidden');render()}
function logDecision(title,text){G.logs.push({age:G.age,chapter:CHAPTERS[G.chapter].label,place:activeEvent?.place||'',title,text,at:new Date().toLocaleString('vi-VN')})}
function advanceChapter(){if(G.chapter>=CHAPTERS.length-1){finish();return}activeEvent=null;showChapter(G.chapter+1)}
function render(){if(!G)return;document.getElementById('avatar').textContent=G.gender==='nữ'?'👩':G.gender==='nam'?'🧑':'🧑‍🎨';document.getElementById('pname').textContent=G.name;document.getElementById('psub').textContent=G.age+' tuổi · '+CHAPTERS[G.chapter].label;let stats=[['Sức khỏe','health','#e98d83'],['Tinh thần','mind','#83b7d9'],['Học tập','study','#85b88a'],['Quan hệ','social','#e7b35e'],['Tài chính','money','#ae9bd1']];document.getElementById('stats').innerHTML=stats.map(([n,k,col])=>`<div class="stat"><div class="statline"><span>${n.toUpperCase()}</span><b>${G[k]}</b></div><div class="track"><div class="fill" style="width:${G[k]}%;background:${col}"></div></div></div>`).join('');document.getElementById('profileInfo').innerHTML=`<b>Gia đình:</b> ${familyText(G)}<br><b>Môi trường:</b> ${G.environment}<br><b>Tính cách:</b> ${G.personality}<br><b>Học tập:</b> ${G.school||'Chưa xác định'}<br><b>Nghề nghiệp:</b> ${G.career||'Chưa xác định'}<br><b>Kinh nghiệm:</b> ${G.exp} XP`;document.getElementById('progress').textContent=`Chương ${G.chapter+1} / ${CHAPTERS.length}`;document.getElementById('progressFill').style.width=((G.chapter+1)/CHAPTERS.length*100)+'%';document.getElementById('progressText').textContent=G.decisions+' quyết định';}
function finish(){G.done=true;document.getElementById('game').classList.add('hidden');document.getElementById('ending').classList.remove('hidden');document.getElementById('endTitle').textContent=`Hành trình của ${G.name}`;document.getElementById('endText').textContent=`Bạn đã đi qua ${CHAPTERS.length} giai đoạn mô phỏng và đưa ra ${G.decisions} quyết định. Những lựa chọn đã tạo nên các trải nghiệm, quan hệ và hướng đi riêng. Đây không phải kết luận về một cuộc đời thật, mà là cơ hội nhìn lại cách mình cân nhắc.`;document.getElementById('endStats').innerHTML=`<p>♥ Sức khỏe: ${G.health} · ☼ Tinh thần: ${G.mind} · ✦ Học tập: ${G.study} · ♧ Quan hệ: ${G.social} · ¤ Tài chính: ${G.money}</p><p>Nghề nghiệp: ${G.career||'Chưa xác định'}</p>`;document.getElementById('endTimeline').innerHTML=G.logs.slice(-8).map(l=>`<div class="log"><b>${l.chapter} · ${l.title}</b><div>${l.text}</div></div>`).join('');saveGame(false)}
function openJournal(){if(!G){showGuide();return}document.getElementById('modalContent').innerHTML='<h2>📖 Nhật ký hành trình</h2>'+G.logs.map(l=>`<div class="log"><b>${l.chapter} · ${l.title}</b><div>${l.text}</div><small>${l.at}</small></div>`).join('')||'Chưa có quyết định nào.';document.getElementById('modal').classList.remove('hidden')}
function showGuide(){document.getElementById('modalContent').innerHTML='<h2>📘 Hướng dẫn chơi</h2><p>Di chuyển bằng WASD, phím mũi tên hoặc cụm nút điều hướng. Đến gần địa điểm và nhấn E để tương tác. Bạn cũng có thể bấm nút địa điểm để di chuyển nhanh.</p><p>Mỗi lựa chọn dẫn đến tình huống liên quan tiếp theo. Một số chuỗi sự kiện diễn ra ngay tại cùng địa điểm; các lựa chọn trước được lưu trong nhật ký và thẻ câu chuyện.</p><p>Đến cuối một giai đoạn, chọn “Tiếp tục giai đoạn” để mở khu vực và câu chuyện mới.</p>';document.getElementById('modal').classList.remove('hidden')}
function closeModal(){document.getElementById('modal').classList.add('hidden')}
function exportJournal(){if(!G)return;let t=G.logs.map(l=>`${l.chapter} | ${l.title}\n${l.text}`).join('\n\n');let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([t],{type:'text/plain;charset=utf-8'}));a.download='nhat-ky-decision-journey.txt';a.click();URL.revokeObjectURL(a.href)}
function saveGame(){if(!G)return;localStorage.setItem(SAVE_KEY,JSON.stringify({G,player,activeEvent,eventHistory,careerIndex,careerStep}));document.getElementById('worldMessage').textContent='Đã lưu hành trình trên thiết bị.'}
function continueGame(){let raw=localStorage.getItem(SAVE_KEY);if(!raw)return;try{let d=JSON.parse(raw);G=d.G;player=d.player;activeEvent=d.activeEvent;eventHistory=d.eventHistory||[];careerIndex=d.careerIndex||0;careerStep=d.careerStep||0;document.getElementById('setup').classList.add('hidden');document.getElementById('game').classList.remove('hidden');showChapter(G.chapter);if(activeEvent){if(activeEvent.key==='career_pick')showCareerPicker();else if(G.career&&activeEvent.key==='career')renderCareerEvent();else renderEvent()}render();drawWorld()}catch(e){alert('Bản lưu không tương thích. Hãy bắt đầu hành trình mới.')}}
function resetGame(){if(!confirm('Bắt đầu cuộc đời mới? Tiến trình hiện tại sẽ được thay thế nếu bạn lưu.'))return;G=null;activeEvent=null;localStorage.removeItem(SAVE_KEY);document.getElementById('ending').classList.add('hidden');document.getElementById('game').classList.add('hidden');document.getElementById('setup').classList.remove('hidden')}
window.addEventListener('keydown',e=>{if(!G||!document.getElementById('modal').classList.contains('hidden'))return;let k=e.key.toLowerCase();if(['arrowup','w'].includes(k)){e.preventDefault();move(0,-1)}else if(['arrowdown','s'].includes(k)){e.preventDefault();move(0,1)}else if(['arrowleft','a'].includes(k)){e.preventDefault();move(-1,0)}else if(['arrowright','d'].includes(k)){e.preventDefault();move(1,0)}else if(k==='e'){e.preventDefault();interact()}});
(function(){let saved=localStorage.getItem(SAVE_KEY);if(saved){document.getElementById('resume').classList.remove('hidden')}})();
</script></body></html>
