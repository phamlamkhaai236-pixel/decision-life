flex-direction:column;gap:7px;margin:10px 0;font-size:12px;font-weight:850;color:#506354}.field input,.field select{padding:12px 13px;border:1px solid #d7d9c9;border-radius:12px;background:#fffefa;color:#34463b;outline:none}.field input:focus,.field select:focus{border-color:#82ae8b;box-shadow:0 0 0 3px #82ae8b26}.start{width:100%;padding:15px;background:linear-gradient(135deg,#6c9b77,#91b78c);color:white;border:0;border-radius:14px;margin-top:12px;box-shadow:0 5px 0 #4d795a,0 10px 20px #416e4d24}.notice{font-size:12px;line-height:1.7;background:#edf4e8;border:1px solid #dce9d6;border-left:4px solid #8bb58b;border-radius:10px;padding:12px;margin:16px 0;color:#607361}.layout{display:grid;grid-template-columns:250px minmax(0,1fr);gap:18px}.side,.main{min-width:0}.side{background:linear-gradient(180deg,#f8f5e9,#eef1e4);border:1px solid #e0dfcf;border-radius:20px;padding:16px;box-shadow:0 8px 25px #233b2c0b}.profile{text-align:center;border-bottom:1px solid #d9dfd1;padding:4px 0 16px}.avatar{font-size:52px;filter:drop-shadow(0 5px 3px #273b2b20)}.profile b{display:block;font-size:16px;color:#345b48;margin-top:5px}.muted{color:var(--muted);font-size:11px}.stat{margin:13px 0}.statline{display:flex;justify-content:space-between;font-size:10px;font-weight:900;color:#647364;margin-bottom:5px}.track{height:9px;background:#e3e7dc;border:0;border-radius:10px;overflow:hidden}.fill{height:100%;width:50%;background:linear-gradient(90deg,#83b58b,#a8c99c);border-radius:10px}.sidebox{background:#fffdf6;border:1px solid #e1dfd0;border-radius:13px;padding:12px;margin-top:13px;font-size:11px;line-height:1.9;color:#687568}.sidebox b{color:#3e614b}.worldbox{background:linear-gradient(145deg,#f5f5e8,#e8f0df);border:1px solid #d8e1d1;border-radius:20px;padding:14px;box-shadow:0 8px 24px #233b2c0b}.worldhead{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:2px 4px 10px}.worldhead b{font-size:16px;color:#355c49}.worldhead p{margin:4px 0 0;font-size:11px;color:#78