<header class="top"><div class="brand">DECISION JOURNEY <small>PIXEL LIFE · YOUR STORY, YOUR CHOICES</small></div><div class="top-actions"><button onclick="showGuide()">📘 Hướng dẫn</button><button onclick="openJournal()">📖 Nhật ký</button><button onclick="saveGame()">💾 Lưu</button><button onclick="resetGame()">↻ Chơi lại</button></div></header>
<main class="wrap">
<section id="setup" class="panel setup"><div class="eyebrow">KHỞI TẠO NHÂN VẬT</div><h1>Một thế giới. Nhiều cuộc đời có thể xảy ra.</h1><p class="intro">Bạn sẽ lớn lên trong một hoàn cảnh nhất định, khám phá những nơi chốn quen thuộc, gặp gỡ nhân vật và đưa ra các quyết định có ảnh hưởng đến những sự kiện tiếp theo. Không có xuất phát điểm nào quyết định toàn bộ tương lai.</p>
<div class="fields"><label class="field">Tên nhân vật<input id="name" value="An" maxlength="24"></label><label class="field">Giới tính nhân vật<select id="gender"><option value="nữ">Nữ</option><option value="nam">Nam</option><option value="khác">Khác / không xác định</option></select></label>
<label class="field">Hoàn cảnh gia đình<select id="family"><option value="stable">Gia đình tương đối ổn định</option><option value="limited">Điều kiện kinh tế còn hạn chế</option><option value="learning">Gia đình coi trọng học tập</option><option value="business">Gia đình kinh doanh / buôn bán</option><option value="farm">Gia đình làm nông</option><option value="single">Gia đình một người chăm sóc chính</option><option value="extended">Gia đình nhiều thế hệ</option></select></label>
<label class="field">Tính cách nổi bật<select id="personality"><option value="curious">Tò mò, thích khám phá</option><option value="careful">Thận trọng, cân nhắc kỹ</option><option value="open">Cởi mở, dễ kết nối</option><option value="independent">Ưa độc lập</option><option value="sensitive">Nhạy cảm, để ý cảm xúc</option><option value="persistent">Kiên trì, bền bỉ</option></select></label>
<label class="field">Môi trường sống<select id="environment"><option value="rural">Nông thôn / vùng ven</option><option value="town">Thị trấn / thị xã</option><option value="city">Đô thị</option><option value="coastal">Vùng ven biển / sông nước</option><option value="mountain">Miền núi</option></select></label>
<label class="field">Nhịp độ mô phỏng<select id="difficulty"><option value="story">Trải nghiệm nhẹ nhàng</option><option value="standard">Cân bằng</option><option value="challenge">Nhiều giới hạn nguồn lực hơn</option></select></label></div>
<div class="notice">Trò chơi là mô phỏng giáo dục, không dự đoán tương lai thật. Chỉ số không phải thước đo giá trị con người; các hoàn cảnh sống khác nhau sẽ tạo ra cơ hội và thách thức khác nhau.</div><button class="start" onclick="startGame()">BẮT ĐẦU CUỘC ĐỜI →</button><div id="resume" class="actions hidden"><button onclick="continueGame()">Tiếp tục bản lưu</button></div></section>
<section id="game" class="panel hidden"><div class="layout"><aside class="side"><div class="profile"><div class="avatar" id="avatar">🧑</div><b id="pname">An</b><div class="muted" id="psub">0 tuổi</div></div><div id="stats"></div><div class="sidebox" id="profileInfo"></div><div class="sidebox"><b>HÀNH TRÌNH</b><div id="progress">Chương 1</div><div class="track"><div id="progressFill" class="fill"></div></div><div class="muted" id="progressText">0 quyết định</div></div></aside>
<div class="main"><div class="worldbox"><div class="worldhead"><div><b id="worldTitle">Khu phố tuổi thơ</b><p id="worldHint">Dùng WASD / phím mũi tên để đi lại. Đến gần địa điểm rồi nhấn E.</p></div><span class="pill" id="agePill">0 TUỔI</span></div><canvas id="world" class="worldcanvas" width="900" height="440"></canvas><div class="worldbar"><div class="dpad"><button class="up" onclick="move(0,-1)">▲</button><button onclick="move(-1,0)">◀</button><button onclick="move(0,1)">▼</button><button onclick="move(1,0)">▶</button></div><div class="worldplaces" id="placeButtons"></div><button onclick="interact()">✦ TƯƠNG TÁC (E)</button></div><div id="worldMessage" class="muted">Hãy khám phá xung quanh.</div></div>
<div class="quest"><div class="questtop"><span id="chapter">CHƯƠNG 01</span><span id="locationLabel">Chưa có sự kiện</span></div><div class="scene"><div class="sceneicon" id="eventIcon">🌱</div><div><h2 id="eventTitle">Một ngày mới</h2><span class="muted" id="eventAge">0–1 tuổi</span></div></div><div class="story" id="eventStory">Cuộc đời bắt đầu.</div><div id="npcLine" class="dialogue hidden"></div><div id="choiceArea"><div class="muted" style="margin-top:12px">Hãy đến một địa điểm và tương tác để mở tình huống.</div></div><div id="outcome" class="result hidden"></div><div class="actions"><button onclick="openJournal()">Xem nhật ký</button><button onclick="saveGame()">Lưu hành trình</button><button id="nextChapter" class="hidden" onclick="advanceChapter()">Tiếp tục giai đoạn →</button></div></div></div></div></section>
<section id="ending" class="panel ending hidden"><div class="eyebrow">HỒ SƠ CUỘC ĐỜI</div><h1 id="endTitle">Hành trình đã khép lại</h1><p id="endText" class="intro"></p><div id="endStats"></div><div id="endTimeline"></div><div class="actions" style="justify-content:center"><button onclick="openJournal()">Xem nhật ký</button><button onclick="exportJournal()">Xuất nhật ký</button><button onclick="resetGame()">Bắt đầu cuộc đời mới</button></div></section>
</main><div id="modal" class="modal hidden" onclick="if(event.target.id==='modal')closeModal()"><div class="modalbox"><div id="modalContent"></div><div class="actions"><button onclick="closeModal()">Đóng</button></div></div></div><div class="footer">DECISION JOURNEY · Mô phỏng lựa chọn và hệ quả qua các giai đoạn cuộc đời</div>
<script>
'use strict';
const CAREERS = [
{id:'police',name:'Công an',field:'An ninh – trật tự',emoji:'🚔',study:'Học tập và rèn luyện theo yêu cầu tuyển sinh, sơ tuyển và đào tạo của ngành.',start:'Bạn tìm hiểu điều kiện tuyển sinh, sơ tuyển, tiêu chuẩn sức khỏe và yêu cầu rèn luyện. Con đường này đòi hỏi kỷ luật, trách nhiệm và hiểu rõ tính chất phục vụ cộng đồng.',events:[['Giai đoạn đào tạo', 'Những ngày đầu trong môi trường đào tạo có kỷ luật cao. Bạn phải thích nghi với lịch học, rèn luyện thể lực, pháp luật và kỹ năng nghiệp vụ.',[['Lập thời khóa biểu, ưu tiên học tập và rèn luyện',{study:8,mind:2},'Bạn dần thích nghi với nhịp độ đào tạo.'],['Chủ động tìm người hướng dẫn và hỏi khi chưa hiểu',{social:7,study:4},'Bạn có thêm mạng lưới hỗ trợ và hiểu rõ hơn yêu cầu nghề.'],['Cân đối sức khỏe, báo cáo khi quá tải',{health:8,mind:6},'Bạn học cách duy trì sức khỏe và kỷ luật bền vững.']]],['Những năm công tác đầu tiên','Bạn được phân công nhiệm vụ tại đơn vị. Tình huống thực tế đòi hỏi bình tĩnh, tuân thủ pháp luật, giao tiếp và phối hợp.',[['Làm việc theo quy trình, ghi nhận đầy đủ thông tin',{exp:8,study:5},'Bạn xây dựng tác phong cẩn trọng và có căn cứ.'],['Rèn kỹ năng giao tiếp, hỗ trợ người dân',{social:8,exp:5},'Bạn tích lũy kinh nghiệm xử lý tình huống với cộng đồng.'],['Tiếp tục học chuyên môn và cập nhật pháp luật',{study:9,exp:6},'Bạn củng cố nền tảng nghiệp vụ.']]],['Định hướng phát triển','Sau một thời gian, bạn cân nhắc hướng chuyên môn, học nâng cao hoặc đảm nhận vai trò quản lý phù hợp.',[['Theo đuổi chuyên môn sâu',{study:10,exp:10},'Bạn phát triển năng lực chuyên môn.'],['Học quản lý, chỉ huy và phối hợp đội nhóm',{social:7,exp:10},'Bạn thử sức với trách nhiệm tổ chức.'],['Cân bằng công việc, gia đình và sức khỏe',{health:8,mind:8},'Bạn xây dựng nhịp sống ổn định hơn.']]]]},
{id:'military',name:'Quân đội',field:'Quốc phòng',emoji:'🎖️',study:'Tìm hiểu sơ tuyển, yêu cầu tuyển sinh, rèn luyện và môi trường đào tạo quân đội.',start:'Bạn lựa chọn tìm hiểu con đường đào tạo và phục vụ trong quân đội. Môi trường này gắn với kỷ luật, tinh thần đồng đội, trách nhiệm và khả năng thích nghi.',events:[['Đào tạo và rèn luyện','Bạn bước vào môi trường học tập có nền nếp, kết hợp kiến thức chuyên môn, thể lực và kỹ năng tập thể.',[['Kiên trì theo kế hoạch rèn luyện',{health:8,study:5},'Bạn cải thiện khả năng tự quản lý.'],['Chủ động phối hợp với đồng đội',{social:8,exp:4},'Tinh thần đồng đội được củng cố.'],['Tìm hiểu sâu chuyên ngành được đào tạo',{study:9,exp:4},'Bạn xác định rõ hướng chuyên môn.']]],['Nhận nhiệm vụ','Bạn bắt đầu công tác tại đơn vị, học cách phối hợp, tuân thủ quy định và xử lý nhiệm vụ được giao.',[['Tập trung hoàn thành nhiệm vụ chuyên môn',{exp:9,study:5},'Bạn tích lũy kinh nghiệm thực tế.'],['Phát triển kỹ năng tổ chức tập thể',{social:8,exp:6},'Bạn được tin tưởng giao thêm trách nhiệm.'],['Duy trì sức khỏe và kết nối gia đình',{health:8,mind:7},'Bạn chú trọng cân bằng cuộc sống.']]],['Con đường lâu dài','Bạn cân nhắc học nâng cao, phát triển chuyên môn hoặc chuyển sang vai trò phù hợp với năng lực và nguyện vọng.',[['Học chuyên sâu',{study:10,exp:8},'Bạn mở rộng năng lực chuyên môn.'],['Theo đuổi công tác tổ chức, quản lý',{social:8,exp:9},'Bạn phát triển năng lực lãnh đạo.'],['Ưu tiên ổn định và đời sống cá nhân',{mind:9,health:7},'Bạn xác lập ưu tiên dài hạn.']]]]},
{id:'doctor',name:'Bác sĩ',field:'Y khoa',emoji:'🩺',study:'Đào tạo y khoa dài hạn, học tập chuyên sâu, thực hành lâm sàng và tuân thủ đạo đức nghề nghiệp.',start:'Bạn theo học ngành Y. Chặng đường đào tạo kéo dài, đòi hỏi kiến thức nền tảng, thực hành, khả năng giao tiếp và tinh thần trách nhiệm với người bệnh.',events:[['Những năm học y','Khối lượng kiến thức lớn và lịch học dày. Bạn cần tìm phương pháp học bền vững, không chỉ cố gắng học thật nhiều.',[['Lập kế hoạch học theo chủ đề và ôn tập đều',{study:10,mind:3},'Bạn hình thành phương pháp học có hệ thống.'],['Tham gia nhóm học tập và trao đổi ca lâm sàng mô phỏng',{social:7,study:6},'Bạn học được cách phối hợp và trình bày lập luận.'],['Tìm cố vấn học tập, cân đối nghỉ ngơi',{health:7,mind:7},'Bạn giảm quá tải và duy trì nhịp học ổn định.']]],['Thực hành lâm sàng','Bạn tiếp xúc môi trường bệnh viện dưới sự hướng dẫn chuyên môn. Việc lắng nghe và giải thích rõ ràng quan trọng không kém kiến thức.',[['Rèn kỹ năng khai thác thông tin và lập luận',{study:8,exp:8},'Bạn tiến bộ trong tư duy lâm sàng.'],['Chú trọng giao tiếp và sự đồng cảm',{social:9,exp:5},'Bạn hiểu hơn trải nghiệm của người bệnh.'],['Xin phản hồi sau mỗi buổi thực hành',{study:6,exp:8},'Bạn biến góp ý thành kế hoạch cải thiện.']]],['Định hướng chuyên khoa','Bạn cân nhắc chuyên khoa, môi trường làm việc và con đường đào tạo tiếp theo.',[['Theo đuổi chuyên khoa phù hợp sở trường',{study:10,exp:8},'Bạn đầu tư chiều sâu chuyên môn.'],['Làm việc tại cơ sở y tế địa phương',{social:8,exp:7},'Bạn gắn chuyên môn với nhu cầu cộng đồng.'],['Kết hợp chuyên môn, nghiên cứu và giảng dạy',{study:8,social:7,exp:8},'Bạn mở rộng vai trò nghề nghiệp.']]]]},
{id:'pharmacist',name:'Dược sĩ',field:'Dược học',emoji:'💊',study:'Học về dược chất, sử dụng thuốc an toàn, kiểm nghiệm, sản xuất hoặc quản lý dược.',start:'Bạn chọn ngành Dược. Công việc có thể gắn với nhà thuốc, bệnh viện, nghiên cứu, kiểm nghiệm, sản xuất hoặc quản lý chất lượng.',events:[['Nền tảng dược học','Bạn học hóa dược, dược lý, bào chế và nguyên tắc sử dụng thuốc hợp lý.',[['Đào sâu kiến thức dược lý',{study:9,exp:4},'Bạn củng cố nền tảng khoa học.'],['Rèn tư vấn sử dụng thuốc dễ hiểu',{social:8,study:5},'Bạn phát triển kỹ năng giao tiếp chuyên môn.'],['Tìm hiểu kiểm nghiệm và chất lượng',{study:8,exp:6},'Bạn khám phá hướng công việc phía sau sản phẩm thuốc.']]],['Thực tập nghề','Bạn trải nghiệm môi trường nhà thuốc, bệnh viện hoặc cơ sở sản xuất.',[['Thực hành quy trình chuyên môn có giám sát',{exp:9,study:5},'Bạn hiểu rõ trách nhiệm nghề nghiệp.'],['Tập trung tư vấn và chăm sóc khách hàng',{social:8,exp:5},'Bạn rèn khả năng giải thích thông tin.'],['Tìm hiểu quản lý kho và chất lượng',{study:7,exp:7},'Bạn phát triển tư duy hệ thống.']]],['Lựa chọn hướng phát triển','Bạn cân nhắc làm việc tại bệnh viện, nhà thuốc, doanh nghiệp dược hoặc nghiên cứu.',[['Theo hướng dược lâm sàng',{study:9,exp:8},'Bạn tập trung vào sử dụng thuốc an toàn.'],['Theo hướng doanh nghiệp dược',{money:8,exp:8},'Bạn hiểu thêm chuỗi cung ứng và thị trường.'],['Theo hướng nghiên cứu, kiểm nghiệm',{study:10,exp:8},'Bạn phát triển năng lực phân tích.']]]]},
{id:'nurse',name:'Điều dưỡng',field:'Chăm sóc sức khỏe',emoji:'🩹',study:'Đào tạo chăm sóc, theo dõi người bệnh, giao tiếp và phối hợp trong nhóm y tế.',start:'Bạn chọn ngành Điều dưỡng. Nghề đòi hỏi kiến thức chuyên môn, sự cẩn trọng, giao tiếp và khả năng làm việc theo nhóm.',events:[['Học kỹ năng chăm sóc','Bạn học quy trình chăm sóc, theo dõi dấu hiệu và giao tiếp với người bệnh.',[['Luyện kỹ năng thực hành theo quy trình',{study:8,exp:5},'Bạn hình thành tác phong cẩn trọng.'],['Rèn giao tiếp và lắng nghe',{social:9,exp:4},'Bạn hiểu vai trò của sự đồng cảm.'],['Học phối hợp nhóm chăm sóc',{social:7,study:5},'Bạn biết cách phối hợp trong môi trường chuyên môn.']]],['Thực tập tại cơ sở y tế','Bạn tham gia thực hành có giám sát, làm quen với nhịp độ và trách nhiệm công việc.',[['Ghi chép, theo dõi và báo cáo chính xác',{study:8,exp:8},'Bạn tăng khả năng quan sát và trách nhiệm.'],['Chú trọng hỗ trợ tinh thần người bệnh',{social:8,mind:5},'Bạn phát triển kỹ năng chăm sóc toàn diện.'],['Học quản lý thời gian và sức khỏe',{health:7,mind:7},'Bạn học cách duy trì sức bền nghề nghiệp.']]],['Phát triển chuyên môn','Bạn cân nhắc chuyên khoa, quản lý điều dưỡng, đào tạo hoặc chăm sóc cộng đồng.',[['Học chuyên sâu một lĩnh vực',{study:9,exp:8},'Bạn xây dựng năng lực chuyên môn.'],['Theo hướng quản lý điều dưỡng',{social:8,exp:8},'Bạn phát triển kỹ năng tổ chức.'],['Tham gia chăm sóc sức khỏe cộng đồng',{social:9,exp:7},'Bạn mở rộng tác động xã hội.']]]]},
{id:'it',name:'Kỹ sư công nghệ thông tin',field:'Công nghệ thông tin',emoji:'💻',study:'Học lập trình, hệ thống, dữ liệu, an toàn thông tin hoặc phát triển sản phẩm số.',start:'Bạn theo học Công nghệ thông tin. Ngành rộng, có nhiều hướng như phần mềm, dữ liệu, mạng, an toàn thông tin, trí tuệ nhân tạo và sản phẩm số.',events:[['Dự án đầu tiên','Bạn cần biến kiến thức thành sản phẩm chạy được, làm việc với lỗi và phản hồi của người dùng.',[['Tự xây dựng dự án cá nhân',{study:9,exp:7},'Bạn có sản phẩm đầu tiên để chứng minh năng lực.'],['Tham gia đội dự án và dùng Git',{social:8,exp:8},'Bạn học quy trình làm việc nhóm.'],['Học nền tảng thuật toán và hệ thống',{study:10,exp:5},'Bạn củng cố tư duy kỹ thuật.']]],['Bước vào doanh nghiệp','Bạn tham gia nhóm phát triển sản phẩm, phải cân bằng chất lượng, tiến độ và yêu cầu thực tế.',[['Theo hướng kỹ sư phần mềm',{money:7,study:8,exp:8},'Bạn tích lũy kinh nghiệm phát triển hệ thống.'],['Theo hướng dữ liệu / AI',{study:10,exp:8},'Bạn đào sâu phân tích và mô hình hóa.'],['Theo hướng an toàn thông tin',{study:9,exp:8},'Bạn tập trung bảo vệ hệ thống và dữ liệu.']]],['Con đường chuyên môn','Bạn cân nhắc chuyên gia kỹ thuật, quản lý sản phẩm, khởi nghiệp hoặc nghiên cứu.',[['Trở thành chuyên gia kỹ thuật',{study:10,exp:10},'Bạn đầu tư vào chiều sâu chuyên môn.'],['Phát triển sản phẩm và quản lý nhóm',{social:8,exp:9},'Bạn mở rộng kỹ năng tổ chức.'],['Khởi nghiệp sản phẩm công nghệ',{money:10,exp:8,mind:-3},'Bạn chấp nhận thử thách và học từ thị trường.']]]]},
{id:'lawyer',name:'Luật sư',field:'Pháp luật',emoji:'⚖️',study:'Học luật, kỹ năng nghiên cứu hồ sơ, lập luận, tư vấn và thực hành nghề theo quy định.',start:'Bạn chọn ngành Luật. Công việc có thể đi theo tư vấn doanh nghiệp, tranh tụng, pháp chế, công chứng hoặc nghiên cứu chính sách.',events:[['Học và đọc hồ sơ','Bạn cần đọc văn bản, phân tích tình huống và lập luận dựa trên căn cứ pháp lý.',[['Rèn kỹ năng nghiên cứu văn bản',{study:9,exp:5},'Bạn hình thành thói quen kiểm chứng căn cứ.'],['Tham gia phiên tòa giả định / tranh biện',{social:8,study:6},'Bạn luyện lập luận và trình bày.'],['Tìm hiểu pháp chế doanh nghiệp',{study:7,exp:6},'Bạn khám phá ứng dụng pháp luật trong tổ chức.']]],['Thực tập nghề luật','Bạn quan sát cách tiếp nhận vụ việc, bảo mật thông tin và làm việc với khách hàng.',[['Theo hướng tư vấn pháp lý',{social:8,exp:8},'Bạn học cách chuyển quy định thành tư vấn dễ hiểu.'],['Theo hướng tranh tụng',{study:8,social:8,exp:7},'Bạn rèn lập luận và chuẩn bị hồ sơ.'],['Theo hướng pháp chế doanh nghiệp',{money:7,exp:8},'Bạn hiểu cách quản trị rủi ro pháp lý.']]],['Xây dựng sự nghiệp','Bạn lựa chọn chuyên môn và cách phát triển uy tín nghề nghiệp.',[['Chuyên sâu một lĩnh vực pháp luật',{study:10,exp:8},'Bạn tạo nền tảng chuyên môn vững.'],['Phát triển văn phòng / dịch vụ tư vấn',{money:8,social:7,exp:8},'Bạn học quản trị dịch vụ chuyên môn.'],['Theo hướng nghiên cứu, chính sách',{study:9,social:7},'Bạn đóng góp qua nghiên cứu và tư vấn chính sách.']]]]},
{id:'teacher',name:'Giáo viên',field:'Giáo dục',emoji:'📚',study:'Đào tạo chuyên môn sư phạm, phương pháp dạy học, đánh giá và hỗ trợ người học.',start:'Bạn chọn nghề giáo viên. Công việc không chỉ là truyền đạt kiến thức mà còn thiết kế hoạt động học, đánh giá và đồng hành với học sinh.',events:[['Thực tập sư phạm','Bạn chuẩn bị bài dạy, đứng lớp và nhận góp ý từ giáo viên hướng dẫn.',[['Đầu tư thiết kế bài học rõ mục tiêu',{study:8,exp:6},'Bạn biết cách tổ chức kiến thức.'],['Tạo hoạt động tương tác cho học sinh',{social:8,exp:6},'Bạn phát triển kỹ năng điều phối lớp học.'],['Quan sát khác biệt và hỗ trợ từng học sinh',{social:9,mind:5},'Bạn hiểu vai trò của sự thấu cảm.']]],['Những năm đầu đứng lớp','Bạn đối mặt với lớp học đa dạng, công việc chuyên môn và phối hợp với phụ huynh.',[['Tập trung đổi mới phương pháp dạy',{study:8,exp:8},'Bạn cải thiện chất lượng hoạt động học.'],['Xây dựng quan hệ tích cực với học sinh',{social:9,exp:6},'Bạn tạo môi trường lớp học tin cậy.'],['Học hỏi đồng nghiệp, dự giờ và phản tư',{study:7,social:7,exp:7},'Bạn phát triển nghề nghiệp liên tục.']]],['Con đường giáo dục','Bạn cân nhắc giáo viên cốt cán, quản lý, nghiên cứu giáo dục hoặc phát triển học liệu.',[['Theo hướng chuyên môn giảng dạy',{study:9,exp:9},'Bạn đào sâu năng lực sư phạm.'],['Theo hướng quản lý giáo dục',{social:8,exp:9},'Bạn phát triển kỹ năng tổ chức.'],['Thiết kế học liệu và công nghệ giáo dục',{study:9,exp:8},'Bạn mở rộng ảnh hưởng qua sản phẩm học tập.']]]]},
{id:'lecturer',name:'Giảng viên đại học',field:'Giáo dục đại học',emoji:'🎓',study:'Học chuyên môn sâu, nghiên cứu, giảng dạy và phát triển học thuật.',start:'Bạn lựa chọn con đường giảng dạy và nghiên cứu ở bậc đại học. Đây là hành trình dài, thường cần học tập nâng cao và xây dựng năng lực nghiên cứu.',events:[['Học sau đại học','Bạn cân nhắc học cao học, tham gia nhóm nghiên cứu và xây dựng hướng chuyên môn.',[['Theo đuổi chương trình sau đại học',{study:10,money:-5},'Bạn đầu tư thời gian cho học thuật.'],['Tham gia dự án nghiên cứu',{exp:8,study:8},'Bạn làm quen với quy trình nghiên cứu.'],['Tích lũy kinh nghiệm chuyên môn thực tiễn',{exp:8,money:5},'Bạn kết nối kiến thức với thực tế.']]],['Bắt đầu giảng dạy','Bạn chuẩn bị học phần, hướng dẫn sinh viên và tham gia hoạt động học thuật.',[['Đổi mới phương pháp giảng dạy',{social:7,study:8},'Bạn cải thiện trải nghiệm học tập.'],['Tập trung công bố và nghiên cứu',{study:10,exp:8},'Bạn phát triển hồ sơ nghiên cứu.'],['Kết nối doanh nghiệp và cộng đồng',{social:8,exp:8},'Bạn mở rộng hợp tác.']]],['Phát triển học thuật','Bạn cân nhắc chuyên gia, quản lý học thuật hoặc tiếp tục nghiên cứu chuyên sâu.',[['Theo hướng nghiên cứu chuyên sâu',{study:10,exp:10},'Bạn xây dựng dấu ấn học thuật.'],['Theo hướng quản lý đào tạo',{social:8,exp:9},'Bạn tham gia phát triển chương trình.'],['Kết hợp nghiên cứu và ứng dụng',{exp:9,social:8},'Bạn kết nối tri thức với nhu cầu xã hội.']]]]},
{id:'economist',name:'Chuyên viên kinh tế',field:'Kinh tế học',emoji:'📈',study:'Học kinh tế, thống kê, phân tích thị trường, chính sách hoặc tài chính.',start:'Bạn theo đuổi lĩnh vực Kinh tế. Các hướng đi có thể gồm phân tích thị trường, kinh tế công, nghiên cứu chính sách, ngân hàng hoặc tư vấn.',events:[['Phân tích dữ liệu kinh tế','Bạn làm quen với dữ liệu, báo cáo và cách diễn giải biến động thị trường.',[['Rèn thống kê và phân tích dữ liệu',{study:9,exp:6},'Bạn tăng năng lực phân tích định lượng.'],['Thực tập tại doanh nghiệp',{money:5,exp:8},'Bạn hiểu quyết định kinh tế trong thực tế.'],['Tham gia nghiên cứu chính sách',{study:8,social:6},'Bạn nhìn vấn đề ở góc độ xã hội.']]],['Bước vào thị trường lao động','Bạn lựa chọn môi trường ngân hàng, doanh nghiệp, cơ quan nghiên cứu hoặc tư vấn.',[['Làm phân tích kinh doanh',{study:8,money:7,exp:8},'Bạn hỗ trợ tổ chức bằng dữ liệu.'],['Làm nghiên cứu kinh tế',{study:9,exp:8},'Bạn đào sâu vấn đề và phương pháp.'],['Làm tài chính – ngân hàng',{money:8,study:7,exp:7},'Bạn phát triển hiểu biết tài chính.']]],['Định hướng chuyên sâu','Bạn cân nhắc chuyên gia phân tích, quản lý, nghiên cứu hoặc khởi nghiệp tư vấn.',[['Trở thành chuyên gia phân tích',{study:9,exp:10},'Bạn đầu tư vào năng lực chuyên môn.'],['Phát triển quản trị và lãnh đạo',{social:8,exp:9},'Bạn mở rộng vai trò điều phối.'],['Khởi nghiệp dịch vụ tư vấn',{money:9,exp:8},'Bạn học cách phát triển khách hàng.']]]]},
{id:'accountant',name:'Kế toán – kiểm toán',field:'Tài chính doanh nghiệp',emoji:'🧾',study:'Học kế toán, kiểm toán, thuế, chuẩn mực báo cáo và hệ thống kiểm soát.',start:'Bạn chọn Kế toán – Kiểm toán. Công việc đòi hỏi sự chính xác, đạo đức nghề nghiệp và khả năng đọc hiểu hoạt động tài chính của tổ chức.',events:[['Nền tảng nghề nghiệp','Bạn học nguyên lý kế toán, báo cáo tài chính, thuế và phần mềm chuyên môn.',[['Luyện nghiệp vụ và chuẩn mực',{study:9,exp:5},'Bạn củng cố độ chính xác.'],['Thực hành phần mềm kế toán',{study:7,exp:7},'Bạn tăng khả năng ứng dụng.'],['Tham gia câu lạc bộ học thuật',{social:6,exp:5},'Bạn mở rộng kết nối nghề nghiệp.']]],['Mùa báo cáo đầu tiên','Bạn xử lý chứng từ, đối chiếu số liệu và phối hợp với các bộ phận.',[['Kiểm tra chéo và lưu vết công việc',{study:8,exp:8},'Bạn xây dựng tác phong kiểm soát.'],['Học giao tiếp với khách hàng nội bộ',{social:8,exp:6},'Bạn cải thiện phối hợp.'],['Theo đuổi chứng chỉ chuyên môn phù hợp',{study:9,money:-3},'Bạn đầu tư cho năng lực dài hạn.']]],['Phát triển nghề','Bạn lựa chọn kiểm toán, kế toán quản trị, thuế hoặc quản lý tài chính.',[['Theo hướng kiểm toán',{study:9,exp:9},'Bạn đào sâu kiểm tra và đánh giá.'],['Theo hướng kế toán quản trị',{money:7,study:8,exp:8},'Bạn hỗ trợ quyết định kinh doanh.'],['Theo hướng thuế và tư vấn',{study:8,social:7,exp:8},'Bạn phát triển chuyên môn tư vấn.']]]]},
{id:'banker',name:'Chuyên viên ngân hàng',field:'Ngân hàng – tài chính',emoji:'🏦',study:'Học tài chính, tín dụng, quản trị rủi ro, dịch vụ khách hàng và tuân thủ.',start:'Bạn bước vào lĩnh vực ngân hàng. Mỗi vị trí có yêu cầu khác nhau: dịch vụ khách hàng, tín dụng, phân tích rủi ro, vận hành hoặc công nghệ tài chính.',events:[['Học nghiệp vụ ngân hàng','Bạn tiếp cận sản phẩm tài chính, quy trình giao dịch và nguyên tắc bảo mật.',[['Rèn nghiệp vụ và tuân thủ',{study:8,exp:6},'Bạn hiểu tầm quan trọng của quy trình.'],['Phát triển tư vấn khách hàng',{social:9,exp:5},'Bạn học cách lắng nghe nhu cầu.'],['Học phân tích tín dụng',{study:9,exp:6},'Bạn rèn đánh giá thông tin và rủi ro.']]],['Công việc đầu tiên','Bạn bắt đầu tại quầy, bộ phận tín dụng, vận hành hoặc phân tích.',[['Theo hướng quan hệ khách hàng',{social:8,money:6,exp:8},'Bạn xây dựng kỹ năng tư vấn.'],['Theo hướng phân tích rủi ro',{study:9,exp:8},'Bạn phát triển tư duy định lượng.'],['Theo hướng vận hành và kiểm soát',{study:8,exp:8},'Bạn củng cố năng lực quy trình.']]],['Bước tiến nghề nghiệp','Bạn cân nhắc chuyên gia, quản lý chi nhánh, quản trị rủi ro hoặc công nghệ tài chính.',[['Chuyên sâu quản trị rủi ro',{study:10,exp:9},'Bạn trở thành người phân tích chuyên sâu.'],['Phát triển quản lý đội nhóm',{social:9,exp:9},'Bạn nhận trách nhiệm điều phối.'],['Chuyển sang đổi mới tài chính số',{study:8,exp:9},'Bạn kết nối tài chính và công nghệ.']]]]},
{id:'entrepreneur',name:'Doanh nhân / chủ doanh nghiệp',field:'Khởi nghiệp và quản trị',emoji:'🏢',study:'Học quản trị, tài chính, thị trường, vận hành và phát triển sản phẩm.',start:'Bạn lựa chọn xây dựng doanh nghiệp. Ý tưởng chưa đủ; bạn cần hiểu khách hàng, dòng tiền, nhân sự, pháp lý và khả năng chịu rủi ro.',events:[['Tìm vấn đề cần giải quyết','Bạn quan sát nhu cầu thực tế và tìm một sản phẩm hoặc dịch vụ có thể tạo giá trị.',[['Khảo sát khách hàng trước khi đầu tư',{study:7,exp:8},'Bạn điều chỉnh ý tưởng dựa trên nhu cầu thật.'],['Tạo sản phẩm thử nghiệm nhỏ',{money:-5,exp:9},'Bạn học từ phản hồi ban đầu.'],['Tìm người đồng hành có kỹ năng bổ sung',{social:8,exp:7},'Bạn hình thành nhóm sáng lập.']]],['Khởi động doanh nghiệp','Bạn phải lựa chọn quy mô, nguồn vốn và cách vận hành phù hợp.',[['Bắt đầu nhỏ, kiểm soát dòng tiền',{money:5,study:7},'Bạn giảm áp lực vốn ban đầu.'],['Gọi vốn và mở rộng nhanh',{money:12,mind:-5,exp:8},'Bạn có thêm nguồn lực nhưng áp lực quản trị tăng.'],['Hợp tác với đối tác chiến lược',{social:8,money:6,exp:7},'Bạn chia sẻ nguồn lực và trách nhiệm.']]],['Vượt qua giai đoạn biến động','Thị trường thay đổi, bạn cần xem xét sản phẩm, nhân sự và mô hình kinh doanh.',[['Tái cấu trúc và tập trung sản phẩm cốt lõi',{study:8,money:7,exp:9},'Doanh nghiệp thích nghi tốt hơn.'],['Mở rộng thị trường có kiểm soát',{money:9,exp:8},'Bạn tăng quy mô với kế hoạch rõ ràng.'],['Chuyển giao một phần điều hành',{social:8,mind:7},'Bạn tạo thêm không gian cho chiến lược dài hạn.']]]]},
{id:'agriculture',name:'Kỹ sư nông nghiệp',field:'Nông nghiệp – phát triển nông thôn',emoji:'🌾',study:'Học khoa học cây trồng, chăn nuôi, đất, nước, công nghệ nông nghiệp và chuỗi giá trị.',start:'Bạn chọn Nông nghiệp. Đây là lĩnh vực rộng, kết nối khoa học, sản xuất, môi trường, thị trường và sinh kế nông thôn.',events:[['Thực địa và nghiên cứu','Bạn đến vùng sản xuất, tìm hiểu đất, nước, giống cây trồng và điều kiện của người nông dân.',[['Nghiên cứu giống và kỹ thuật canh tác',{study:9,exp:7},'Bạn phát triển năng lực kỹ thuật.'],['Làm việc cùng hợp tác xã và nông hộ',{social:9,exp:6},'Bạn hiểu nhu cầu sản xuất tại địa phương.'],['Tìm hiểu nông nghiệp công nghệ cao',{study:8,exp:7},'Bạn kết nối khoa học với công nghệ.']]],['Triển khai mô hình sản xuất','Bạn tham gia dự án cải tiến quy trình, chất lượng hoặc đầu ra nông sản.',[['Thử nghiệm mô hình canh tác bền vững',{study:8,exp:9},'Bạn chú trọng hiệu quả dài hạn.'],['Phát triển chuỗi liên kết tiêu thụ',{social:8,money:6,exp:8},'Bạn kết nối sản xuất với thị trường.'],['Ứng dụng dữ liệu và tự động hóa',{study:9,exp:8},'Bạn đưa công nghệ vào sản xuất.']]],['Định hướng nghề nghiệp','Bạn cân nhắc nghiên cứu, doanh nghiệp nông nghiệp, khuyến nông hoặc khởi nghiệp.',[['Theo hướng nghiên cứu nông nghiệp',{study:10,exp:8},'Bạn phát triển chuyên môn khoa học.'],['Làm khuyến nông và phát triển cộng đồng',{social:10,exp:8},'Bạn hỗ trợ sinh kế địa phương.'],['Khởi nghiệp nông sản / công nghệ nông nghiệp',{money:8,exp:9},'Bạn thử xây dựng mô hình kinh doanh.']]]]},
{id:'forestry',name:'Kỹ sư lâm nghiệp',field:'Lâm nghiệp – tài nguyên rừng',emoji:'🌳',study:'Học sinh thái rừng, quản lý tài nguyên, bảo tồn đa dạng sinh học và phục hồi hệ sinh thái.',start:'Bạn theo đuổi Lâm nghiệp. Công việc có thể gắn với quản lý rừng, bảo tồn, phục hồi hệ sinh thái, quy hoạch và sinh kế cộng đồng.',events:[['Khảo sát hệ sinh thái','Bạn tham gia khảo sát hiện trạng rừng và tìm hiểu mối quan hệ giữa cộng đồng với tài nguyên.',[['Tập trung điều tra đa dạng sinh học',{study:9,exp:7},'Bạn rèn kỹ năng khảo sát khoa học.'],['Làm việc với cộng đồng địa phương',{social:9,exp:6},'Bạn hiểu sinh kế và tri thức bản địa.'],['Học GIS và bản đồ tài nguyên',{study:8,exp:7},'Bạn tăng năng lực phân tích không gian.']]],['Dự án bảo vệ và phục hồi','Bạn tham gia dự án phục hồi rừng, phòng cháy, quản lý tài nguyên hoặc sinh kế.',[['Theo hướng phục hồi rừng',{exp:9,study:8},'Bạn đóng góp vào hệ sinh thái.'],['Theo hướng quản lý tài nguyên',{study:9,exp:8},'Bạn phát triển năng lực quy hoạch.'],['Theo hướng giáo dục môi trường',{social:9,exp:7},'Bạn lan tỏa nhận thức cộng đồng.']]],['Phát triển chuyên môn','Bạn lựa chọn nghiên cứu, quản lý khu bảo tồn hoặc dự án phát triển bền vững.',[['Nghiên cứu sinh thái',{study:10,exp:8},'Bạn đào sâu chuyên môn.'],['Quản lý dự án bảo tồn',{social:8,exp:9},'Bạn điều phối nhiều bên liên quan.'],['Tư vấn phát triển bền vững',{money:7,exp:8},'Bạn kết nối chuyên môn và chính sách.']]]]},
{id:'fisheries',name:'Kỹ sư thủy sản',field:'Thủy sản – kinh tế biển',emoji:'🐟',study:'Học nuôi trồng thủy sản, bệnh học thủy sản, môi trường nước và chuỗi cung ứng.',start:'Bạn chọn Thủy sản. Nghề có thể gắn với nuôi trồng, nghiên cứu giống, quản lý môi trường nước, chế biến và phát triển kinh tế ven biển.',events:[['Học tại cơ sở nuôi trồng','Bạn tìm hiểu chất lượng nước, con giống, quy trình chăm sóc và phòng bệnh.',[['Theo hướng kỹ thuật nuôi',{study:8,exp:8},'Bạn hiểu sâu quy trình sản xuất.'],['Theo hướng quản lý môi trường nước',{study:9,exp:7},'Bạn chú trọng chất lượng hệ sinh thái.'],['Theo hướng giống và bệnh học',{study:10,exp:7},'Bạn đào sâu khoa học thủy sản.']]],['Làm việc với vùng nuôi','Bạn hỗ trợ cơ sở sản xuất giải quyết vấn đề kỹ thuật và đầu ra.',[['Tư vấn quy trình nuôi bền vững',{social:8,exp:9},'Bạn kết nối chuyên môn với người nuôi.'],['Làm tại doanh nghiệp chế biến',{money:7,exp:8},'Bạn hiểu chuỗi giá trị.'],['Tham gia nghiên cứu và kiểm nghiệm',{study:9,exp:8},'Bạn phát triển năng lực khoa học.']]],['Định hướng lâu dài','Bạn cân nhắc nghiên cứu, doanh nghiệp, quản lý vùng nuôi hoặc khởi nghiệp.',[['Nghiên cứu công nghệ thủy sản',{study:10,exp:9},'Bạn phát triển giải pháp kỹ thuật.'],['Quản lý vùng nuôi / chuỗi cung ứng',{social:8,money:7,exp:9},'Bạn mở rộng trách nhiệm.'],['Khởi nghiệp sản phẩm thủy sản',{money:8,exp:8},'Bạn thử sức với thị trường.']]]]},
{id:'veterinarian',name:'Bác sĩ thú y',field:'Thú y',emoji:'🐾',study:'Học giải phẫu, bệnh học, chẩn đoán, điều trị và sức khỏe cộng đồng liên quan động vật.',start:'Bạn chọn ngành Thú y. Công việc có thể ở phòng khám thú cưng, trang trại, kiểm dịch, nghiên cứu hoặc quản lý dịch bệnh động vật.',events:[['Đào tạo chuyên môn','Bạn học kiến thức thú y và thực hành chăm sóc, khám và phòng bệnh.',[['Rèn kỹ năng khám và chẩn đoán',{study:9,exp:6},'Bạn phát triển tư duy chuyên môn.'],['Tìm hiểu thú y cộng đồng và kiểm dịch',{study:8,exp:7},'Bạn nhìn rộng hơn về sức khỏe cộng đồng.'],['Thực hành chăm sóc động vật',{social:7,exp:7},'Bạn tăng trải nghiệm thực tế.']]],['Chọn môi trường làm việc','Bạn cân nhắc phòng khám thú cưng, trang trại, cơ quan chuyên môn hoặc phòng thí nghiệm.',[['Làm tại phòng khám thú cưng',{social:8,exp:8},'Bạn xây dựng quan hệ với chủ nuôi.'],['Làm tại trang trại và cơ sở chăn nuôi',{study:8,exp:8},'Bạn xử lý vấn đề sức khỏe đàn vật nuôi.'],['Theo hướng kiểm dịch và phòng dịch',{study:9,exp:8},'Bạn tham gia bảo vệ sức khỏe cộng đồng.']]],['Phát triển nghề nghiệp','Bạn lựa chọn chuyên khoa, quản lý phòng khám hoặc nghiên cứu.',[['Chuyên sâu một nhóm động vật',{study:9,exp:9},'Bạn phát triển chuyên môn.'],['Mở cơ sở dịch vụ thú y',{money:8,social:7,exp:8},'Bạn học quản lý dịch vụ.'],['Nghiên cứu bệnh học và vaccine',{study:10,exp:9},'Bạn theo đuổi nghiên cứu.']]]]},
{id:'architect',name:'Kiến trúc sư',field:'Kiến trúc – quy hoạch',emoji:'🏛️',study:'Học thiết kế không gian, mỹ thuật, kỹ thuật công trình, quy hoạch và phần mềm chuyên ngành.',start:'Bạn chọn Kiến trúc. Mỗi đồ án là sự cân bằng giữa thẩm mỹ, công năng, ngân sách, môi trường và nhu cầu người sử dụng.',events:[['Đồ án đầu tiên','Bạn phát triển ý tưởng thiết kế và phải bảo vệ phương án trước giảng viên.',[['Nghiên cứu người sử dụng và bối cảnh',{study:8,exp:7},'Thiết kế của bạn có cơ sở rõ hơn.'],['Đầu tư thể hiện ý tưởng sáng tạo',{study:8,social:5},'Bạn phát triển phong cách cá nhân.'],['Học kỹ thuật và vật liệu',{study:9,exp:6},'Bạn cân bằng ý tưởng với tính khả thi.']]],['Công trình thực tế','Bạn tham gia nhóm thiết kế, phối hợp kỹ sư và tiếp nhận yêu cầu khách hàng.',[['Theo hướng thiết kế nhà ở',{exp:8,money:6},'Bạn hiểu nhu cầu không gian sống.'],['Theo hướng công trình công cộng',{social:8,exp:8},'Bạn quan tâm trải nghiệm cộng đồng.'],['Theo hướng quy hoạch đô thị',{study:9,exp:8},'Bạn nhìn ở quy mô hệ thống.']]],['Dấu ấn nghề nghiệp','Bạn cân nhắc làm chuyên gia, mở văn phòng hoặc theo hướng nghiên cứu bền vững.',[['Phát triển studio kiến trúc',{money:8,exp:9},'Bạn xây dựng thương hiệu nghề nghiệp.'],['Theo hướng quy hoạch và chính sách',{study:9,social:8},'Bạn tham gia định hình không gian sống.'],['Chuyên sâu kiến trúc xanh',{study:9,exp:9},'Bạn theo đuổi thiết kế bền vững.']]]]},
{id:'civilengineer',name:'Kỹ sư xây dựng',field:'Kỹ thuật xây dựng',emoji:'🏗️',study:'Học kết cấu, vật liệu, địa kỹ thuật, quản lý thi công và an toàn công trình.',start:'Bạn chọn Kỹ thuật xây dựng. Công việc có thể ở thiết kế kết cấu, thi công, giám sát, quản lý dự án hoặc kiểm định công trình.',events:[['Học và thực hành kỹ thuật','Bạn làm quen bản vẽ, tính toán kết cấu và tiêu chuẩn kỹ thuật.',[['Tập trung thiết kế và tính toán',{study:9,exp:6},'Bạn phát triển nền tảng kỹ thuật.'],['Thực tập tại công trường',{exp:9,health:-2},'Bạn hiểu quy trình thi công thực tế.'],['Học quản lý an toàn và chất lượng',{study:8,exp:7},'Bạn chú trọng trách nhiệm công trình.']]],['Dự án đầu tiên','Bạn tham gia một công trình, phối hợp với nhiều bộ phận và xử lý thay đổi tiến độ.',[['Theo hướng kỹ thuật hiện trường',{exp:9,social:6},'Bạn tích lũy kinh nghiệm công trường.'],['Theo hướng thiết kế kết cấu',{study:9,exp:8},'Bạn đào sâu chuyên môn.'],['Theo hướng quản lý dự án',{social:8,exp:8},'Bạn rèn điều phối.']]],['Phát triển sự nghiệp','Bạn cân nhắc chuyên gia, quản lý dự án hoặc tư vấn độc lập.',[['Chuyên sâu kỹ thuật',{study:10,exp:9},'Bạn xây dựng năng lực chuyên gia.'],['Quản lý dự án lớn',{social:9,exp:9},'Bạn mở rộng trách nhiệm.'],['Tư vấn và kiểm định công trình',{study:9,exp:8},'Bạn phát triển vai trò độc lập.']]]]},
{id:'journalist',name:'Nhà báo / phóng viên',field:'Báo chí',emoji:'🎙️',study:'Học báo chí, xác minh thông tin, phỏng vấn, viết, biên tập và đạo đức truyền thông.',start:'Bạn chọn Báo chí. Công việc đòi hỏi tò mò, kiểm chứng nguồn tin, khả năng kể chuyện và trách nhiệm với thông tin công chúng.',events:[['Tác phẩm đầu tay','Bạn tìm đề tài, tiếp cận nhân vật và xác minh thông tin trước khi xuất bản.',[['Kiểm chứng nhiều nguồn độc lập',{study:8,exp:8},'Bạn hình thành thói quen xác minh.'],['Rèn kỹ năng phỏng vấn',{social:9,exp:6},'Bạn biết lắng nghe và đặt câu hỏi.'],['Thử nghiệm báo chí dữ liệu',{study:9,exp:7},'Bạn kết hợp số liệu với câu chuyện.']]],['Nhịp làm báo','Bạn xử lý thời hạn, phản hồi và trách nhiệm khi đưa thông tin ra công chúng.',[['Theo mảng điều tra / chuyên sâu',{study:9,exp:9},'Bạn đào sâu một vấn đề.'],['Theo mảng văn hóa – đời sống',{social:8,exp:8},'Bạn kết nối với nhiều cộng đồng.'],['Theo hướng biên tập và kiểm chứng',{study:8,exp:8},'Bạn nâng chất lượng nội dung.']]],['Định hướng nghề','Bạn cân nhắc phóng viên chuyên trách, biên tập, sản xuất nội dung hoặc nghiên cứu truyền thông.',[['Trở thành phóng viên chuyên sâu',{exp:9,social:7},'Bạn tạo dấu ấn ở lĩnh vực phụ trách.'],['Theo hướng biên tập / quản lý nội dung',{study:8,exp:9},'Bạn phát triển năng lực tổ chức nội dung.'],['Làm truyền thông dữ liệu và nghiên cứu',{study:9,exp:8},'Bạn kết nối truyền thông với phân tích.']]]]},
{id:'translator',name:'Biên phiên dịch viên',field:'Ngôn ngữ',emoji:'🌐',study:'Học ngôn ngữ, văn hóa, kỹ năng dịch, biên tập và giao tiếp liên văn hóa.',start:'Bạn chọn con đường ngôn ngữ. Nghề có thể phát triển trong biên dịch, phiên dịch, giáo dục, ngoại giao, du lịch hoặc doanh nghiệp quốc tế.',events:[['Tích lũy năng lực ngôn ngữ','Bạn rèn nghe, nói, đọc, viết và hiểu bối cảnh văn hóa.',[['Đọc rộng và xây dựng vốn thuật ngữ',{study:9,exp:5},'Bạn cải thiện độ chính xác.'],['Thực hành giao tiếp và phiên dịch',{social:8,exp:7},'Bạn tăng phản xạ giao tiếp.'],['Theo một lĩnh vực chuyên ngành',{study:9,exp:6},'Bạn tạo lợi thế chuyên môn.']]],['Dự án dịch đầu tiên','Bạn nhận bản dịch hoặc hỗ trợ phiên dịch, cần cân bằng tốc độ và chất lượng.',[['Theo hướng biên dịch chuyên ngành',{study:9,exp:8},'Bạn đào sâu chất lượng bản dịch.'],['Theo hướng phiên dịch hội nghị',{social:9,exp:8},'Bạn rèn xử lý tình huống trực tiếp.'],['Theo hướng bản địa hóa nội dung số',{study:8,exp:8},'Bạn kết nối ngôn ngữ và công nghệ.']]],['Phát triển sự nghiệp','Bạn cân nhắc làm tự do, doanh nghiệp, giáo dục hoặc quản lý dự án ngôn ngữ.',[['Xây dựng nhóm dịch thuật độc lập',{money:7,social:8,exp:8},'Bạn học quản lý khách hàng.'],['Làm trong doanh nghiệp quốc tế',{money:8,exp:8},'Bạn phát triển môi trường chuyên nghiệp.'],['Kết hợp ngôn ngữ và giảng dạy',{social:8,study:8},'Bạn chia sẻ năng lực ngôn ngữ.']]]]},
{id:'actor',name:'Diễn viên',field:'Nghệ thuật biểu diễn',emoji:'🎭',study:'Rèn diễn xuất, hình thể, tiếng nói, phân tích nhân vật và làm việc trên sân khấu / phim trường.',start:'Bạn theo đuổi diễn xuất. Con đường có tính cạnh tranh, thu nhập có thể không ổn định và cần rèn nghề, xây dựng hồ sơ vai diễn cũng như kỹ năng làm việc nhóm.',events:[['Đào tạo diễn xuất','Bạn tham gia lớp học, bài tập hình thể, tiếng nói và phân tích nhân vật.',[['Học bài bản và luyện tập đều',{study:8,exp:7},'Bạn xây dựng nền tảng nghề.'],['Tham gia sân khấu sinh viên',{social:8,exp:7},'Bạn có trải nghiệm biểu diễn đầu tiên.'],['Tự quay cảnh diễn và xin góp ý',{exp:8,study:6},'Bạn học từ phản hồi cụ thể.']]],['Buổi thử vai','Bạn tham gia casting, có thể được chọn hoặc cần tiếp tục hoàn thiện hồ sơ.',[['Chọn vai phù hợp năng lực',{mind:6,exp:8},'Bạn tích lũy kinh nghiệm có chọn lọc.'],['Thử sức vai diễn khó hơn',{exp:9,mind:-3},'Bạn mở rộng giới hạn chuyên môn.'],['Kết hợp công việc ổn định khi chờ cơ hội',{money:6,mind:7},'Bạn giảm áp lực tài chính.']]],['Xây dựng sự nghiệp','Bạn cân nhắc sân khấu, phim ảnh, đào tạo hoặc sản xuất nội dung.',[['Theo sân khấu chuyên nghiệp',{social:8,exp:9},'Bạn gắn bó với biểu diễn trực tiếp.'],['Theo phim ảnh và truyền hình',{exp:9,money:7},'Bạn mở rộng cơ hội dự án.'],['Kết hợp diễn xuất và giảng dạy',{study:7,social:8},'Bạn chia sẻ kinh nghiệm nghề.']]]]},
{id:'singer',name:'Ca sĩ',field:'Âm nhạc – biểu diễn',emoji:'🎤',study:'Rèn thanh nhạc, nhạc lý, biểu diễn, luyện tập và quản lý hoạt động nghệ thuật.',start:'Bạn chọn con đường ca hát. Thành công nghề nghiệp cần rèn luyện chuyên môn, bản sắc nghệ thuật, sức khỏe giọng hát và quản lý công việc.',events:[['Rèn luyện thanh nhạc','Bạn học kỹ thuật thanh nhạc, nhạc lý và biểu diễn.',[['Theo học thanh nhạc bài bản',{study:9,exp:6},'Bạn củng cố kỹ thuật.'],['Tham gia ban nhạc / hợp xướng',{social:8,exp:7},'Bạn học phối hợp âm nhạc.'],['Sáng tác và tìm màu sắc riêng',{study:8,exp:7},'Bạn phát triển bản sắc nghệ thuật.']]],['Cơ hội biểu diễn','Bạn nhận lời mời biểu diễn, thu âm hoặc tham gia cuộc thi.',[['Tập trung xây dựng sản phẩm âm nhạc',{exp:9,money:-3},'Bạn đầu tư vào chất lượng sản phẩm.'],['Biểu diễn tại sự kiện và sân khấu nhỏ',{social:8,exp:8},'Bạn tích lũy kinh nghiệm sân khấu.'],['Chọn lịch làm việc cân bằng',{health:8,mind:7},'Bạn bảo vệ sức khỏe và giọng hát.']]],['Định hình sự nghiệp','Bạn cân nhắc hoạt động độc lập, hợp tác với công ty hoặc giảng dạy âm nhạc.',[['Phát triển nghệ sĩ độc lập',{money:7,exp:9},'Bạn chủ động định hướng sản phẩm.'],['Hợp tác với đơn vị sản xuất',{social:8,exp:8},'Bạn tiếp cận nguồn lực chuyên nghiệp.'],['Kết hợp biểu diễn và đào tạo',{study:8,social:8},'Bạn mở rộng hoạt động nghệ thuật.']]]]},
{id:'model',name:'Người mẫu',field:'Thời trang – trình diễn',emoji:'👠',study:'Rèn trình diễn, tạo dáng, giao tiếp nghề nghiệp, hiểu hợp đồng và an toàn lao động.',start:'Bạn tìm hiểu nghề người mẫu. Đây là công việc dự án, cần kỹ năng trình diễn, tác phong chuyên nghiệp, hiểu hợp đồng và biết bảo vệ quyền lợi cá nhân.',events:[['Xây dựng hồ sơ nghề','Bạn chuẩn bị portfolio, tìm hiểu đơn vị quản lý và quy tắc làm việc an toàn.',[['Học trình diễn và tạo dáng chuyên nghiệp',{exp:7,study:6},'Bạn nâng kỹ năng nghề.'],['Tìm hiểu hợp đồng và quyền hình ảnh',{study:8,mind:5},'Bạn biết bảo vệ quyền lợi của mình.'],['Tham gia dự án nhỏ có chọn lọc',{social:7,exp:7},'Bạn tích lũy kinh nghiệm.']]],['Làm việc theo dự án','Bạn phối hợp với nhiếp ảnh gia, nhà thiết kế, ê-kíp và khách hàng.',[['Theo hướng trình diễn thời trang',{exp:9,social:7},'Bạn phát triển kỹ năng sân khấu.'],['Theo hướng quảng cáo thương mại',{money:7,exp:8},'Bạn học làm việc với khách hàng.'],['Theo hướng mẫu ảnh / nội dung',{social:8,exp:8},'Bạn mở rộng hình thức hợp tác.']]],['Con đường dài hạn','Bạn cân nhắc quản lý hình ảnh, đào tạo, kinh doanh thời trang hoặc chuyển hướng nghề.',[['Trở thành người hướng dẫn trình diễn',{social:8,study:7},'Bạn chia sẻ kinh nghiệm.'],['Phát triển thương hiệu / kinh doanh thời trang',{money:8,exp:8},'Bạn mở rộng sang kinh doanh.'],['Chuyển sang sản xuất và quản lý nghệ thuật',{exp:8,study:7},'Bạn tiếp tục hoạt động trong lĩnh vực sáng tạo.']]]]},
