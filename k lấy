 let near=nearestPlaceId(),eventNpc=activeEvent&&EVENTS[activeEvent.key]?NPCS[EVENTS[activeEvent.key].npc]:null;
 if(eventNpc&&PLACE[eventNpc.place||activeEvent.place]){let q=PLACE[activeEvent.place]||PLACE[eventNpc.place];sprite(q.x+43,q.y+17,'#d58b78','#59453d');}
 // player shadow and character
 x.fillStyle='#40574355';x.beginPath();x.ellipse(player.x,player.y+28,15,6,0,0,Math.PI*2);x.fill();
