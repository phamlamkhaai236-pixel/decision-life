{id:'designer',name:'Nhà thiết kế đồ họa',field:'Thiết kế sáng tạo',emoji:'🎨',study:'Học thiết kế thị giác, typography, màu sắc, công cụ số, tư duy người dùng và bản quyền.',start:'Bạn chọn Thiết kế đồ họa. Nghề có thể làm nhận diện thương hiệu, minh họa, giao diện số, quảng cáo, xuất bản hoặc thiết kế chuyển động.',events:[['Đồ án thiết kế','Bạn xây dựng portfolio và học cách giải thích lựa chọn thị giác.',[['Theo hướng nhận diện thương hiệu',{study:8,exp:7},'Bạn học tạo hệ thống hình ảnh nhất quán.'],['Theo hướng minh họa và sáng tạo',{exp:8,social:6},'Bạn phát triển ngôn ngữ cá nhân.'],['Theo hướng UI / UX',{study:9,exp:7},'Bạn kết nối thiết kế với trải nghiệm người dùng.']]],['Làm việc với khách hàng','Bạn nhận brief, phản hồi và chỉnh sửa theo mục tiêu dự án.',[['Làm tại studio sáng tạo',{social:8,exp:8},'Bạn học quy trình chuyên nghiệp.'],['Làm thiết kế in-house doanh nghiệp',{money:7,exp:8},'Bạn hiểu thương hiệu dài hạn.'],['Làm tự do theo dự án',{money:8,exp:7},'Bạn tự quản lý khách hàng và thời gian.']]],['Phát triển chuyên môn','Bạn cân nhắc chuyên gia thiết kế, giám đốc sáng tạo, mở studio hoặc đào tạo.',[['Chuyên sâu thiết kế sản phẩm số',{study:9,exp:9},'Bạn tăng năng lực chuyên môn.'],['Theo hướng giám đốc sáng tạo',{social:9,exp:9},'Bạn điều phối ý tưởng và đội ngũ.'],['Mở studio riêng',{money:8,exp:8},'Bạn xây dựng thương hiệu cá nhân.']]]]},
{id:'filmmaker',name:'Đạo diễn / nhà làm phim',field:'Điện ảnh – truyền hình',emoji:'🎬',study:'Học ngôn ngữ điện ảnh, kịch bản, quay dựng, sản xuất và quản lý ê-kíp.',start:'Bạn chọn làm phim. Đây là công việc phối hợp sáng tạo và tổ chức, từ phát triển ý tưởng đến sản xuất, hậu kỳ và phát hành.',events:[['Phim ngắn đầu tay','Bạn tập hợp ê-kíp nhỏ và lựa chọn câu chuyện có thể thực hiện.',[['Viết kịch bản và phát triển nhân vật',{study:8,exp:7},'Bạn tập trung vào cấu trúc câu chuyện.'],['Thử sức quay và dựng phim',{study:8,exp:8},'Bạn hiểu quy trình kỹ thuật.'],['Tổ chức ê-kíp và sản xuất',{social:9,exp:7},'Bạn rèn năng lực điều phối.']]],['Dự án chuyên nghiệp','Bạn tham gia đoàn phim, cần cân đối sáng tạo, ngân sách và tiến độ.',[['Theo hướng đạo diễn nội dung',{exp:9,study:7},'Bạn phát triển tư duy hình ảnh.'],['Theo hướng sản xuất phim',{money:7,social:8,exp:9},'Bạn học quản trị dự án.'],['Theo hướng biên kịch',{study:9,exp:8},'Bạn đào sâu cấu trúc và nhân vật.']]],['Định hướng dài hạn','Bạn cân nhắc làm phim độc lập, truyền hình, quảng cáo hoặc đào tạo.',[['Làm phim độc lập',{exp:10,money:-4},'Bạn theo đuổi dự án cá nhân.'],['Phát triển hãng / nhóm sản xuất',{money:8,social:8},'Bạn xây dựng tổ chức sáng tạo.'],['Giảng dạy và cố vấn làm phim',{study:8,social:8},'Bạn truyền lại kinh nghiệm.']]]]},
{id:'chef',name:'Đầu bếp',field:'Ẩm thực – dịch vụ',emoji:'👨‍🍳',study:'Học kỹ thuật chế biến, an toàn thực phẩm, quản lý bếp, thực đơn và chi phí.',start:'Bạn chọn nghề đầu bếp. Con đường có thể bắt đầu từ trường nghề, học việc hoặc chương trình đào tạo ẩm thực.',events:[['Học nghề bếp','Bạn rèn kỹ thuật sơ chế, chế biến, vệ sinh và phối hợp trong bếp.',[['Học bài bản tại trường nghề',{study:7,exp:7},'Bạn nắm nền tảng kỹ thuật.'],['Học việc tại nhà hàng',{exp:9,health:-2},'Bạn tiếp xúc nhịp độ thực tế.'],['Tìm hiểu ẩm thực địa phương',{study:7,social:7},'Bạn khám phá bản sắc món ăn.']]],['Ca làm việc đầu tiên','Bạn làm việc trong bếp, phối hợp thời gian và chất lượng món ăn.',[['Theo hướng bếp nóng / món chính',{exp:9,study:5},'Bạn nâng tay nghề chế biến.'],['Theo hướng bánh và tráng miệng',{study:8,exp:8},'Bạn rèn độ chính xác.'],['Theo hướng quản lý bếp',{social:8,exp:8},'Bạn học tổ chức nhân sự và quy trình.']]],['Phát triển nghề','Bạn cân nhắc trở thành bếp trưởng, mở quán, làm dịch vụ tiệc hoặc đào tạo.',[['Phấn đấu thành bếp trưởng',{exp:9,social:8},'Bạn chịu trách nhiệm chất lượng toàn bếp.'],['Mở quán ăn riêng',{money:8,exp:8},'Bạn bước vào quản trị kinh doanh.'],['Phát triển ẩm thực địa phương',{study:8,social:8},'Bạn kết nối món ăn với văn hóa.']]]]},
{id:'hotel',name:'Quản trị khách sạn – du lịch',field:'Du lịch – dịch vụ',emoji:'🏨',study:'Học quản trị dịch vụ, vận hành, ngoại ngữ, chăm sóc khách hàng và phát triển điểm đến.',start:'Bạn chọn lĩnh vực khách sạn – du lịch. Công việc có thể ở lễ tân, điều hành tour, quản trị lưu trú, sự kiện hoặc phát triển du lịch cộng đồng.',events:[['Thực tập dịch vụ','Bạn học cách xử lý yêu cầu khách hàng và phối hợp giữa các bộ phận.',[['Theo hướng lễ tân và trải nghiệm khách',{social:9,exp:6},'Bạn phát triển giao tiếp dịch vụ.'],['Theo hướng điều hành tour',{exp:8,study:6},'Bạn học tổ chức lịch trình.'],['Theo hướng quản trị vận hành',{study:8,exp:7},'Bạn hiểu quy trình dịch vụ.']]],['Mùa cao điểm','Bạn xử lý lượng khách tăng, lịch làm việc thay đổi và tình huống phát sinh.',[['Tập trung chất lượng phục vụ',{social:9,exp:8},'Bạn xây dựng uy tín dịch vụ.'],['Ứng dụng hệ thống đặt chỗ và dữ liệu',{study:8,exp:8},'Bạn cải thiện vận hành.'],['Phát triển sản phẩm du lịch địa phương',{social:8,exp:8},'Bạn kết nối cộng đồng và du khách.']]],['Con đường quản lý','Bạn cân nhắc quản lý cơ sở, điều hành doanh nghiệp lữ hành hoặc khởi nghiệp dịch vụ.',[['Quản lý khách sạn',{exp:9,social:9},'Bạn phát triển năng lực quản trị.'],['Khởi nghiệp du lịch cộng đồng',{money:7,social:9,exp:8},'Bạn xây dựng sản phẩm địa phương.'],['Theo hướng đào tạo dịch vụ',{study:8,social:8},'Bạn chia sẻ kinh nghiệm.']]]]},
{id:'pilot',name:'Phi công',field:'Hàng không',emoji:'✈️',study:'Tìm hiểu yêu cầu đào tạo, sức khỏe, ngoại ngữ, kiến thức hàng không và quy trình an toàn.',start:'Bạn tìm hiểu con đường phi công. Đây là lĩnh vực có yêu cầu tuyển chọn, đào tạo, sức khỏe và quy trình an toàn nghiêm ngặt; cần tìm hiểu điều kiện thực tế trước khi quyết định.',events:[['Đào tạo hàng không','Bạn học kiến thức khí tượng, nguyên lý bay, quy trình và phối hợp tổ lái.',[['Học lý thuyết và quy trình kỹ lưỡng',{study:10,exp:5},'Bạn xây dựng nền tảng an toàn.'],['Rèn ngoại ngữ chuyên ngành',{study:8,exp:6},'Bạn cải thiện giao tiếp chuyên môn.'],['Duy trì sức khỏe và kỷ luật cá nhân',{health:9,mind:5},'Bạn hiểu yêu cầu sức khỏe nghề.']]],['Tích lũy giờ bay','Bạn tiếp tục huấn luyện và thực hành dưới giám sát theo chương trình được phê duyệt.',[['Tuân thủ quy trình và học từ đánh giá',{exp:9,study:7},'Bạn hình thành tác phong chuyên nghiệp.'],['Rèn phối hợp tổ lái',{social:8,exp:7},'Bạn hiểu vai trò giao tiếp.'],['Tiếp tục học chuyên môn',{study:9,exp:6},'Bạn củng cố kiến thức.']]],['Phát triển nghề','Bạn cân nhắc chuyên môn khai thác, huấn luyện hoặc các vai trò khác trong hàng không.',[['Theo hướng khai thác bay',{exp:10,study:7},'Bạn tiếp tục phát triển chuyên môn.'],['Theo hướng huấn luyện khi đủ điều kiện',{social:8,exp:9},'Bạn chia sẻ kinh nghiệm.'],['Chuyển sang quản lý an toàn / khai thác',{study:9,social:7},'Bạn mở rộng góc nhìn hệ thống.']]]]},
{id:'scientist',name:'Nhà khoa học / nghiên cứu viên',field:'Nghiên cứu khoa học',emoji:'🔬',study:'Học phương pháp nghiên cứu, chuyên ngành, thống kê, đạo đức nghiên cứu và công bố khoa học.',start:'Bạn chọn con đường nghiên cứu. Công việc cần câu hỏi rõ ràng, phương pháp phù hợp, dữ liệu đáng tin cậy và khả năng chấp nhận kết quả không như dự đoán.',events:[['Hình thành câu hỏi nghiên cứu','Bạn tìm hiểu tài liệu, xác định khoảng trống và thiết kế nghiên cứu.',[['Đọc tổng quan và xác định câu hỏi',{study:10,exp:5},'Bạn học cách đặt vấn đề.'],['Tham gia nhóm nghiên cứu',{social:8,exp:7},'Bạn làm quen cộng tác khoa học.'],['Học phương pháp và thống kê',{study:9,exp:6},'Bạn củng cố năng lực phương pháp.']]],['Thực hiện nghiên cứu','Bạn thu thập dữ liệu, ghi chép quy trình và phân tích kết quả.',[['Ưu tiên tính minh bạch dữ liệu',{study:9,exp:9},'Bạn xây dựng nền tảng nghiên cứu đáng tin cậy.'],['Trao đổi phản biện với đồng nghiệp',{social:8,study:7},'Bạn cải thiện lập luận.'],['Công bố và chia sẻ kết quả',{exp:8,social:7},'Bạn đưa tri thức đến cộng đồng.']]],['Con đường học thuật','Bạn cân nhắc học cao hơn, làm nghiên cứu ứng dụng hoặc chuyển giao công nghệ.',[['Theo hướng nghiên cứu cơ bản',{study:10,exp:9},'Bạn đào sâu tri thức.'],['Theo hướng nghiên cứu ứng dụng',{exp:9,money:6},'Bạn kết nối khoa học với thực tiễn.'],['Theo hướng chuyển giao công nghệ',{social:8,exp:9},'Bạn đưa kết quả vào ứng dụng.']]]]},
{id:'civilservant',name:'Công chức / chuyên viên chính sách',field:'Quản lý nhà nước',emoji:'🏛️',study:'Học hành chính, pháp luật, chính sách công, phân tích dữ liệu và phục vụ người dân.',start:'Bạn chọn làm việc trong khu vực công. Công việc có thể ở quản lý hành chính, phân tích chính sách, dịch vụ công hoặc phát triển địa phương.',events:[['Bắt đầu công tác','Bạn làm quen quy trình hành chính, văn bản và nhu cầu của người dân.',[['Nắm chắc quy định và quy trình',{study:8,exp:7},'Bạn xây dựng tác phong chính xác.'],['Lắng nghe phản ánh từ người dân',{social:9,exp:6},'Bạn hiểu nhu cầu thực tế.'],['Học phân tích dữ liệu địa phương',{study:9,exp:7},'Bạn đưa bằng chứng vào công việc.']]],['Giải quyết vấn đề công','Bạn tham gia một nhiệm vụ liên ngành cần phối hợp và giải trình.',[['Tập trung cải tiến thủ tục',{exp:9,study:7},'Bạn góp phần cải thiện dịch vụ công.'],['Phối hợp các bên liên quan',{social:9,exp:8},'Bạn nâng khả năng điều phối.'],['Nghiên cứu tác động chính sách',{study:9,exp:8},'Bạn xem xét hệ quả của quyết định.']]],['Phát triển nghề nghiệp','Bạn cân nhắc chuyên viên sâu, quản lý, nghiên cứu hoặc công tác cộng đồng.',[['Theo hướng chuyên môn chính sách',{study:9,exp:9},'Bạn phát triển năng lực phân tích.'],['Theo hướng quản lý công',{social:9,exp:9},'Bạn nhận trách nhiệm tổ chức.'],['Theo hướng phát triển địa phương',{social:8,exp:9},'Bạn gắn công việc với cộng đồng.']]]]},
{id:'socialworker',name:'Nhân viên công tác xã hội',field:'Công tác xã hội',emoji:'🤝',study:'Học tham vấn cơ bản, kết nối dịch vụ, đánh giá nhu cầu và nguyên tắc bảo vệ người được hỗ trợ.',start:'Bạn chọn Công tác xã hội. Công việc hướng đến hỗ trợ cá nhân, gia đình và cộng đồng tiếp cận nguồn lực, dịch vụ và cơ hội phù hợp.',events:[['Thực hành có giám sát','Bạn học cách lắng nghe, đánh giá nhu cầu và tôn trọng quyền riêng tư.',[['Rèn kỹ năng lắng nghe và ghi nhận',{social:9,exp:6},'Bạn xây dựng quan hệ hỗ trợ.'],['Học quy trình kết nối dịch vụ',{study:8,exp:7},'Bạn hiểu hệ thống nguồn lực.'],['Tham gia dự án cộng đồng',{social:8,exp:8},'Bạn học cách làm việc với nhóm.']]],['Đồng hành cùng cộng đồng','Bạn phối hợp với trường học, cơ sở xã hội và tổ chức địa phương.',[['Theo hướng công tác xã hội học đường',{social:9,exp:8},'Bạn hỗ trợ môi trường giáo dục.'],['Theo hướng bảo trợ và dịch vụ cộng đồng',{exp:9,study:7},'Bạn kết nối người dân với dịch vụ.'],['Theo hướng phát triển dự án xã hội',{study:8,social:8},'Bạn thiết kế hoạt động có mục tiêu.']]],['Phát triển chuyên môn','Bạn cân nhắc quản lý chương trình, đào tạo hoặc nghiên cứu xã hội.',[['Quản lý chương trình hỗ trợ',{social:8,exp:9},'Bạn phát triển năng lực điều phối.'],['Đào tạo và giám sát chuyên môn',{study:8,social:8},'Bạn hỗ trợ người làm nghề.'],['Nghiên cứu và vận động chính sách',{study:9,exp:8},'Bạn đóng góp bằng bằng chứng.']]]]},
{id:'psychologist',name:'Nhà tâm lý học',field:'Tâm lý học',emoji:'🧠',study:'Học tâm lý học, phương pháp nghiên cứu, đạo đức, đánh giá và thực hành trong phạm vi đào tạo.',start:'Bạn chọn Tâm lý học. Lĩnh vực có nhiều hướng: nghiên cứu, tâm lý học giáo dục, tổ chức, tham vấn hoặc các chuyên ngành cần đào tạo và giám sát chuyên sâu.',events:[['Nền tảng tâm lý học','Bạn học các lý thuyết, phương pháp nghiên cứu và nguyên tắc đạo đức.',[['Tập trung phương pháp nghiên cứu',{study:9,exp:6},'Bạn hiểu cách kiểm chứng giả thuyết.'],['Tham gia dự án tâm lý học giáo dục',{social:8,exp:7},'Bạn tiếp cận bối cảnh trường học.'],['Tìm hiểu tâm lý học tổ chức',{study:8,exp:7},'Bạn khám phá môi trường lao động.']]],['Thực hành có giám sát','Bạn quan sát và thực hành trong phạm vi năng lực, dưới sự hướng dẫn phù hợp.',[['Theo hướng tâm lý học học đường',{social:9,exp:8},'Bạn tìm hiểu nhu cầu học sinh.'],['Theo hướng tâm lý học tổ chức',{study:8,exp:8},'Bạn nghiên cứu hành vi trong công việc.'],['Theo hướng nghiên cứu thực nghiệm',{study:10,exp:8},'Bạn đào sâu bằng chứng khoa học.']]],['Phát triển nghề','Bạn cân nhắc học nâng cao, nghiên cứu, đào tạo hoặc làm trong tổ chức.',[['Học chuyên sâu và giám sát chuyên môn',{study:10,exp:8},'Bạn củng cố năng lực và đạo đức nghề.'],['Làm nghiên cứu và đánh giá chương trình',{study:9,exp:9},'Bạn tạo bằng chứng ứng dụng.'],['Phát triển đào tạo kỹ năng tâm lý',{social:8,exp:8},'Bạn chuyển tri thức thành hoạt động giáo dục.']]]]},
{id:'designerfashion',name:'Nhà thiết kế thời trang',field:'Thời trang',emoji:'🧵',study:'Học thiết kế trang phục, chất liệu, rập, kỹ thuật may, xu hướng và phát triển bộ sưu tập.',start:'Bạn chọn Thiết kế thời trang. Con đường kết hợp sáng tạo, kỹ thuật, hiểu người mặc, sản xuất và kinh doanh.',events:[['Bộ sưu tập sinh viên','Bạn nghiên cứu chủ đề, chất liệu và tạo mẫu.',[['Nghiên cứu chất liệu và kỹ thuật',{study:8,exp:7},'Bạn tạo thiết kế có tính khả thi.'],['Tìm phong cách sáng tạo riêng',{exp:8,social:6},'Bạn phát triển dấu ấn cá nhân.'],['Hợp tác với nhóm may và tạo mẫu',{social:8,exp:7},'Bạn hiểu quy trình sản xuất.']]],['Ra mắt sản phẩm','Bạn giới thiệu thiết kế, tiếp nhận phản hồi và tính toán chi phí.',[['Làm việc tại thương hiệu thời trang',{money:7,exp:8},'Bạn hiểu thị trường.'],['Phát triển nhãn hàng độc lập',{money:8,exp:8},'Bạn học xây dựng thương hiệu.'],['Theo hướng trang phục sân khấu / điện ảnh',{exp:9,social:7},'Bạn kết nối thời trang và nghệ thuật.']]],['Con đường dài hạn','Bạn cân nhắc giám đốc sáng tạo, kinh doanh, đào tạo hoặc thời trang bền vững.',[['Phát triển thương hiệu riêng',{money:9,exp:9},'Bạn xây dựng hệ sinh thái sản phẩm.'],['Theo hướng thời trang bền vững',{study:9,exp:8},'Bạn chú trọng tác động môi trường.'],['Đào tạo thiết kế và kỹ thuật',{study:8,social:8},'Bạn truyền lại kinh nghiệm.']]]]},
{id:'mechanic',name:'Kỹ thuật viên ô tô / cơ khí',field:'Cơ khí – kỹ thuật',emoji:'🔧',study:'Học cơ khí, điện – điện tử, chẩn đoán, bảo trì, an toàn và công nghệ phương tiện.',start:'Bạn chọn nghề kỹ thuật ô tô – cơ khí. Có thể học trường nghề, cao đẳng hoặc đại học kỹ thuật; năng lực thực hành và cập nhật công nghệ rất quan trọng.',events:[['Học nghề và thực hành','Bạn làm quen dụng cụ, quy trình bảo trì và an toàn lao động.',[['Theo chương trình trường nghề',{study:7,exp:8},'Bạn tích lũy kỹ năng thực hành.'],['Học việc tại xưởng có hướng dẫn',{exp:9,study:4},'Bạn tiếp xúc tình huống thực tế.'],['Học thêm điện – điện tử phương tiện',{study:9,exp:6},'Bạn chuẩn bị cho công nghệ mới.']]],['Đi làm kỹ thuật','Bạn tiếp nhận phương tiện, chẩn đoán vấn đề và trao đổi với khách hàng.',[['Theo hướng chẩn đoán chuyên sâu',{study:8,exp:9},'Bạn nâng kỹ năng kỹ thuật.'],['Theo hướng quản lý xưởng dịch vụ',{social:8,exp:8},'Bạn học tổ chức công việc.'],['Theo hướng xe điện và công nghệ mới',{study:9,exp:8},'Bạn thích nghi với chuyển đổi công nghệ.']]],['Phát triển nghề','Bạn cân nhắc chuyên gia kỹ thuật, mở xưởng hoặc đào tạo nghề.',[['Trở thành kỹ thuật viên chuyên sâu',{exp:10,study:7},'Bạn tạo uy tín chuyên môn.'],['Mở cơ sở dịch vụ',{money:8,exp:8},'Bạn chuyển sang quản trị kinh doanh.'],['Trở thành giáo viên hướng dẫn nghề',{study:8,social:8},'Bạn chia sẻ kỹ năng thực hành.']]]]},
