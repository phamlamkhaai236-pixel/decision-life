ound:#f8f0df;border:1px solid #eadbbd;border-radius:12px;font-size:12px;line-height:1.75;color:#6b6049}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.pill{display:inline-block;padding:7px 10px;background:#e3efdf;border:1px solid #d2e3ce;border-radius:20px;font-size:10px;font-weight:950;color:#4d7555}.modal{position:fixed;inset:0;background:#1d3029b8;backdrop-filter:blur(5px);z-index:10;display:grid;place-items:center;padding:12px}.modalbox{width:min(720px,100%);max-height:88vh;overflow:auto;background:#fffdf5;border:1px solid #e2ddce;border-radius:22px;padding:22px;box-shadow:0 20px 70px #14271d55}.log{padding:12px;border:1px solid #e3dfd2;border-radius:12px;margin:8px 0;background:#fffefa;font-size:12px;line-height:1.7}.ending{text-align:center}.careergrid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.careerbtn{text-align:left;font-size:11px}.careerbtn small{display:block;color:var(--muted);font-weight:500;margin-top:4px}.footer{font-size:10px;color:#899487;text-align:center;margin:18px}
